////////////////////////////////////////////////////////////////////////////////
// Модуль AIR_ReadCore расширения AIDataRead.
//
// Назначение: общий серверный код read-only сервиса:
//   * типизированные параметры query/DCS (string, number, boolean, date,
//     uuid, predefinedRef, null, reference);
//   * допуск запроса: платформенный разбор, обход известного AST,
//     канонический round-trip и узкий лексер запрета блокировок;
//   * общие ошибки, JSON-сериализация и SHA-256 текста;
//   * конечные hard caps сервиса.
//
// Инварианты: модуль серверный, неглобальный, непривилегированный, без
// ServerCall; он не выполняет запросы и не содержит обработчиков HTTP.
////////////////////////////////////////////////////////////////////////////////

Функция КраткоОбрезать(Текст, Максимум) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Если СтрДлина(Текст) > Максимум Тогда
		Возврат Лев(Текст, Максимум) + "...(обрезано)";
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция ТекстJSON(Данные) Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.ПроверятьСтруктуру = Истина;
	Запись.УстановитьСтроку();
	ЗаписатьJSONЗначение(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

Процедура ЗаписатьJSONЗначение(Запись, Значение)

	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Запись.ЗаписатьЗначение(Неопределено);
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево")
		ИЛИ ТипЗнч(Значение) = Тип("Число")
		ИЛИ ТипЗнч(Значение) = Тип("Строка") Тогда
		Запись.ЗаписатьЗначение(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Запись.ЗаписатьЗначение(XMLСтрока(Значение));
	ИначеЕсли ТипЗнч(Значение) = Тип("УникальныйИдентификатор") Тогда
		Запись.ЗаписатьЗначение(Строка(Значение));
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Запись.ЗаписатьНачалоМассива();
		Для Каждого Элемент Из Значение Цикл
			ЗаписатьJSONЗначение(Запись, Элемент);
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
	ИначеЕсли ТипЗнч(Значение) = Тип("Структура")
		ИЛИ ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Запись.ЗаписатьНачалоОбъекта();
		Для Каждого Элемент Из Значение Цикл
			Запись.ЗаписатьИмяСвойства(Строка(Элемент.Ключ));
			ЗаписатьJSONЗначение(Запись, Элемент.Значение);
		КонецЦикла;
		Запись.ЗаписатьКонецОбъекта();
	Иначе
		Если ЭтоСсылка(Значение) Тогда
			ЗаписатьСсылкуJSON(Запись, Значение);
		Иначе
			ВызватьИсключение ОшибкаСервиса("unsupported_result_value",
				"Тип значения результата не поддерживается в JSON: " + Строка(ТипЗнч(Значение)));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьСсылкуJSON(Запись, Значение)

	Мета = Значение.Метаданные();
	Представление = XMLСтрока(Значение);
	Запись.ЗаписатьНачалоОбъекта();
	Если ЭтоУИД(Представление) Тогда
		Запись.ЗаписатьИмяСвойства("type");
		Запись.ЗаписатьЗначение("reference");
		Запись.ЗаписатьИмяСвойства("typeName");
		Запись.ЗаписатьЗначение(Мета.ПолноеИмя());
		Запись.ЗаписатьИмяСвойства("uuid");
		Запись.ЗаписатьЗначение(Представление);
		Запись.ЗаписатьИмяСвойства("presentation");
		Запись.ЗаписатьЗначение(Строка(Значение));
		Запись.ЗаписатьИмяСвойства("empty");
		Запись.ЗаписатьЗначение(Представление = "00000000-0000-0000-0000-000000000000");
	Иначе
		// Значения перечислений в XML-форме — имя, а не UUID; отдельный typed-вид.
		Запись.ЗаписатьИмяСвойства("type");
		Запись.ЗаписатьЗначение("enum");
		Запись.ЗаписатьИмяСвойства("typeName");
		Запись.ЗаписатьЗначение(Мета.ПолноеИмя());
		Запись.ЗаписатьИмяСвойства("name");
		Запись.ЗаписатьЗначение(Представление);
		Запись.ЗаписатьИмяСвойства("presentation");
		Запись.ЗаписатьЗначение(Строка(Значение));
		Запись.ЗаписатьИмяСвойства("empty");
		Запись.ЗаписатьЗначение(Представление = "");
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();

КонецПроцедуры

Функция ЭтоСсылка(Значение) Экспорт

	Попытка
		Мета = Значение.Метаданные();
		Возврат Мета <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ОшибкаСервиса(Код, Сообщение) Экспорт

	Возврат "AIR|" + Код + "|" + Сообщение;

КонецФункции

Функция ВидЗначения(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат "null";
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат "string";
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат "number";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат "boolean";
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат "date";
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат "uuid";
	ИначеЕсли ЭтоСсылка(Значение) Тогда
		Возврат "reference";
	КонецЕсли;
	Возврат "unsupported";

КонецФункции

Функция ПредставлениеПараметров(Параметры) Экспорт

	Результат = Новый Массив;
	Для Каждого КЗ Из Параметры Цикл
		Вид = ВидЗначения(КЗ.Значение);
		Элемент = Новый Структура("name,valueType", Строка(КЗ.Ключ), Вид);
		Если Вид = "reference" Тогда
			Мета = КЗ.Значение.Метаданные();
			Элемент.Вставить("typeName", Мета.ПолноеИмя());
			Элемент.Вставить("emptyRef", XMLСтрока(КЗ.Значение) = "00000000-0000-0000-0000-000000000000");
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ТвердыеМаксимумы() Экспорт

	Максимумы = Новый Структура;
	Максимумы.Вставить("maxRows", 5000);
	Максимумы.Вставить("maxColumns", 200);
	Максимумы.Вставить("maxCells", 200000);
	Максимумы.Вставить("maxResponseBytes", 4194304);
	Максимумы.Вставить("maxRequestBytes", 262144);
	Максимумы.Вставить("maxQueryTextLength", 65536);
	Максимумы.Вставить("maxParameters", 64);
	Максимумы.Вставить("maxDcsRequestBytes", 2097152);
	Максимумы.Вставить("maxDcsSchemaBytes", 1048576);
	Максимумы.Вставить("maxPreviewRows", 20);
	Максимумы.Вставить("maxArtifactBytes", 5242880);
	Максимумы.Вставить("maxDcsResponseBytes", 6291456);
	Возврат Максимумы;

КонецФункции

Функция ТвердыйМаксимум(Имя) Экспорт

	Максимумы = ТвердыеМаксимумы();
	Значение = Неопределено;
	Если Максимумы.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	ВызватьИсключение ОшибкаСервиса("internal_error", "Неизвестный предел: " + Имя);

КонецФункции

Функция ПреобразоватьПараметры(МассивПараметров) Экспорт

	Результат = Новый Соответствие;
	Встречались = Новый Соответствие;
	Для Каждого Элемент Из МассивПараметров Цикл
		Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
			ВызватьИсключение ОшибкаСервиса("invalid_parameter", "Каждый параметр должен быть объектом.");
		КонецЕсли;
		Имя = Элемент.Получить("name");
		Если ТипЗнч(Имя) <> Тип("Строка") ИЛИ НЕ ЭтоДопустимоеИмя(Имя) Тогда
			ВызватьИсключение ОшибкаСервиса("invalid_parameter", "Некорректное имя параметра запроса.");
		КонецЕсли;
		// Имена параметров 1С регистронезависимы; маркер отдельный, чтобы
		// повтор после первого null/Неопределено тоже детектировался.
		КлючПараметра = ВРег(Имя);
		Если Встречались.Получить(КлючПараметра) <> Неопределено Тогда
			ВызватьИсключение ОшибкаСервиса("duplicate_parameter", "Параметр задан повторно: " + Имя);
		КонецЕсли;
		Встречались.Вставить(КлючПараметра, Истина);
		Значение = ЗначениеПараметра(Элемент);
		Результат.Вставить(Имя, Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЗначениеПараметра(Элемент)

	Вид = ПолеПараметра(Элемент, "valueType");
	Если Вид = Неопределено Тогда
		Вид = ПолеПараметра(Элемент, "type");
	КонецЕсли;
	Вид = ?(Вид = Неопределено, "", НРег(СокрЛП(Строка(Вид))));

	Если Вид = "" Тогда
		Возврат ЗначениеПоУмолчанию(Элемент);
	КонецЕсли;
	Если Вид = "string" Тогда
		Значение = ЗначениеПараметраИзЭлемента(Элемент);
		Если ТипЗнч(Значение) <> Тип("Строка") Тогда
			ВызватьИсключение ОшибкаСервиса("invalid_parameter_value", "Параметр string требует строковое value.");
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	Если Вид = "number" Тогда
		Значение = ЗначениеПараметраИзЭлемента(Элемент);
		Если ТипЗнч(Значение) <> Тип("Число") Тогда
			ВызватьИсключение ОшибкаСервиса("invalid_parameter_value", "Параметр number требует числовое value.");
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	Если Вид = "boolean" Тогда
		Значение = ЗначениеПараметраИзЭлемента(Элемент);
		Если ТипЗнч(Значение) <> Тип("Булево") Тогда
			ВызватьИсключение ОшибкаСервиса("invalid_parameter_value", "Параметр boolean требует булево value.");
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	Если Вид = "date" Тогда
		Значение = ЗначениеПараметраИзЭлемента(Элемент);
		Если ТипЗнч(Значение) <> Тип("Строка") ИЛИ СокрЛП(Значение) = "" Тогда
			ВызватьИсключение ОшибкаСервиса("invalid_parameter_value",
				"Параметр date требует непустое строковое value в формате ISO.");
		КонецЕсли;
		Попытка
			Дата = ПрочитатьДатуJSON(СокрЛП(Значение), ФорматДатыJSON.ISO);
		Исключение
			ВызватьИсключение ОшибкаСервиса("invalid_parameter_value", "Не удалось разобрать дату параметра.");
		КонецПопытки;
		Возврат Дата;
	КонецЕсли;
	Если Вид = "uuid" Тогда
		Значение = ЗначениеПараметраИзЭлемента(Элемент);
		Если ТипЗнч(Значение) <> Тип("Строка") ИЛИ НЕ ЭтоУИД(СокрЛП(Значение)) Тогда
			ВызватьИсключение ОшибкаСервиса("invalid_parameter_value",
				"Параметр uuid требует value в каноническом UUID-виде.");
		КонецЕсли;
		Возврат Новый УникальныйИдентификатор(СокрЛП(Значение));
	КонецЕсли;
	Если Вид = "predefinedref" Тогда
		Путь = ПолеПараметра(Элемент, "path");
		Если ТипЗнч(Путь) <> Тип("Строка") ИЛИ СокрЛП(Путь) = "" Тогда
			ВызватьИсключение ОшибкаСервиса("invalid_parameter_value", "Для predefinedRef требуется path.");
		КонецЕсли;
		Возврат ЗначениеПредопределеннойСсылки(СокрЛП(Путь));
	КонецЕсли;
	Если Вид = "null" Тогда
		// typed null: тип задаёт typeName; zero-UUID-ссылка не подменяет null.
		ИмяТипа = ПолеПараметра(Элемент, "typeName");
		Если ТипЗнч(ИмяТипа) <> Тип("Строка") ИЛИ СокрЛП(ИмяТипа) = "" Тогда
			ВызватьИсключение ОшибкаСервиса("invalid_parameter_value",
				"Для параметра valueType=null требуется typeName ссылочного типа.");
		КонецЕсли;
		Возврат ПустаяСсылкаПараметра(СокрЛП(ИмяТипа));
	КонецЕсли;
	Если Вид = "undefined" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Вид = "reference" ИЛИ Вид = "catalogref" ИЛИ Вид = "documentref" Тогда
		Возврат ЗначениеСсылкиПараметра(Элемент);
	КонецЕсли;
	ВызватьИсключение ОшибкаСервиса("unsupported_parameter_type",
		"Неподдерживаемый valueType параметра. Допустимы: string, number, boolean, date, uuid, predefinedRef, null, reference.");

КонецФункции

Функция ПолеПараметра(Элемент, Имя)

	// Map-форма normalize_runtime_parameters поднимает typeName/valueType и
	// оставляет исходный объект во вложенном value; читаем оба уровня явно.
	Значение = Элемент.Получить(Имя);
	Если Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Вложенное = Элемент.Получить("value");
	Если ТипЗнч(Вложенное) = Тип("Соответствие") Тогда
		Возврат Вложенное.Получить(Имя);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ЗначениеПараметраИзЭлемента(Элемент)

	Значение = Элемент.Получить("value");
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат Значение.Получить("value");
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ЗначениеПоУмолчанию(Элемент)

	Если ПолеПараметра(Элемент, "uuid") <> Неопределено И ПолеПараметра(Элемент, "typeName") <> Неопределено Тогда
		Возврат ЗначениеСсылкиПараметра(Элемент);
	КонецЕсли;
	Значение = ЗначениеПараметраИзЭлемента(Элемент);
	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли ТипЗначения = Тип("Строка") ИЛИ ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	ВызватьИсключение ОшибкаСервиса("unsupported_parameter_type",
		"Невозможно определить тип значения параметра; укажите valueType.");

КонецФункции

Функция ЗначениеСсылкиПараметра(Элемент)

	ИмяТипа = ПолеПараметра(Элемент, "typeName");
	УИД = ПолеПараметра(Элемент, "uuid");
	Если ТипЗнч(ИмяТипа) <> Тип("Строка") ИЛИ СокрЛП(ИмяТипа) = "" Тогда
		ВызватьИсключение ОшибкаСервиса("invalid_parameter_value", "Для reference требуется typeName.");
	КонецЕсли;
	Если ТипЗнч(УИД) <> Тип("Строка") ИЛИ НЕ ЭтоУИД(УИД) Тогда
		ВызватьИсключение ОшибкаСервиса("invalid_parameter_value", "Для reference требуется uuid в каноническом виде.");
	КонецЕсли;
	ПолноеИмя = НормализоватьИмяТипаСсылки(СокрЛП(ИмяТипа));
	Мета = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если Мета = Неопределено Тогда
		ВызватьИсключение ОшибкаСервиса("unknown_reference_type", "Тип ссылки не найден в конфигурации: " + ПолноеИмя);
	КонецЕсли;
	ПрефиксСправочника = "Справочник.";
	ПрефиксДокумента = "Документ.";
	Если Лев(ПолноеИмя, СтрДлина(ПрефиксСправочника)) = ПрефиксСправочника Тогда
		Если Метаданные.Справочники.Найти(Мета.Имя) = Неопределено Тогда
			ВызватьИсключение ОшибкаСервиса("unknown_reference_type", "Справочник не найден: " + ПолноеИмя);
		КонецЕсли;
		ИмяТипаСсылки = "СправочникСсылка." + Мета.Имя;
	ИначеЕсли Лев(ПолноеИмя, СтрДлина(ПрефиксДокумента)) = ПрефиксДокумента Тогда
		Если Метаданные.Документы.Найти(Мета.Имя) = Неопределено Тогда
			ВызватьИсключение ОшибкаСервиса("unknown_reference_type", "Документ не найден: " + ПолноеИмя);
		КонецЕсли;
		ИмяТипаСсылки = "ДокументСсылка." + Мета.Имя;
	Иначе
		ВызватьИсключение ОшибкаСервиса("unsupported_parameter_type",
			"Поддерживаются только ссылки справочников и документов.");
	КонецЕсли;
	ТипСсылки = Тип(ИмяТипаСсылки);
	Если ТипСсылки = Неопределено Тогда
		ВызватьИсключение ОшибкаСервиса("unknown_reference_type", "Тип ссылки недоступен: " + ИмяТипаСсылки);
	КонецЕсли;
	Попытка
		Значение = XMLЗначение(ТипСсылки, УИД);
	Исключение
		ВызватьИсключение ОшибкаСервиса("invalid_parameter_value", "Не удалось преобразовать uuid ссылки.");
	КонецПопытки;
	Если Значение = Неопределено Тогда
		ВызватьИсключение ОшибкаСервиса("invalid_parameter_value", "Не удалось преобразовать uuid ссылки.");
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ПустаяСсылкаПараметра(ИмяТипа)

	ПолноеИмя = НормализоватьИмяТипаСсылки(СокрЛП(ИмяТипа));
	Мета = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если Мета = Неопределено Тогда
		ВызватьИсключение ОшибкаСервиса("unknown_reference_type", "Тип ссылки не найден в конфигурации: " + ПолноеИмя);
	КонецЕсли;
	ПрефиксСправочника = "Справочник.";
	ПрефиксДокумента = "Документ.";
	Если Лев(ПолноеИмя, СтрДлина(ПрефиксСправочника)) = ПрефиксСправочника Тогда
		Если Метаданные.Справочники.Найти(Мета.Имя) = Неопределено Тогда
			ВызватьИсключение ОшибкаСервиса("unknown_reference_type", "Справочник не найден: " + ПолноеИмя);
		КонецЕсли;
		Возврат Справочники[Мета.Имя].ПустаяСсылка();
	ИначеЕсли Лев(ПолноеИмя, СтрДлина(ПрефиксДокумента)) = ПрефиксДокумента Тогда
		Если Метаданные.Документы.Найти(Мета.Имя) = Неопределено Тогда
			ВызватьИсключение ОшибкаСервиса("unknown_reference_type", "Документ не найден: " + ПолноеИмя);
		КонецЕсли;
		Возврат Документы[Мета.Имя].ПустаяСсылка();
	КонецЕсли;
	ВызватьИсключение ОшибкаСервиса("unsupported_parameter_type",
		"Поддерживаются только ссылки справочников и документов.");

КонецФункции

Функция ЗначениеПредопределеннойСсылки(Путь)

	НормализованныйПуть = СокрЛП(Путь);
	Если Лев(НормализованныйПуть, СтрДлина("Справочники.")) = "Справочники." Тогда
		НормализованныйПуть = "Справочник." + Сред(НормализованныйПуть, СтрДлина("Справочники.") + 1);
	ИначеЕсли Лев(НормализованныйПуть, СтрДлина("Справочник.")) <> "Справочник." Тогда
		ВызватьИсключение ОшибкаСервиса("invalid_parameter_value",
			"Для predefinedRef поддерживается metadata path Справочник.<Имя>.<ПредопределённыйЭлемент>.");
	КонецЕсли;
	Попытка
		Ссылка = ПредопределенноеЗначение(НормализованныйПуть);
	Исключение
		ВызватьИсключение ОшибкаСервиса("invalid_parameter_value",
			"Не удалось разрешить predefinedRef metadata path.");
	КонецПопытки;
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение ОшибкаСервиса("invalid_parameter_value",
			"Предопределённая ссылка не разрешилась в заполненное значение.");
	КонецЕсли;
	Возврат Ссылка;

КонецФункции

Функция НормализоватьИмяТипаСсылки(ИмяТипа)

	ПрефиксСсылки = "СправочникСсылка.";
	Если Лев(ИмяТипа, СтрДлина(ПрефиксСсылки)) = ПрефиксСсылки Тогда
		Возврат "Справочник." + Сред(ИмяТипа, СтрДлина(ПрефиксСсылки) + 1);
	КонецЕсли;
	ПрефиксДокумента = "ДокументСсылка.";
	Если Лев(ИмяТипа, СтрДлина(ПрефиксДокумента)) = ПрефиксДокумента Тогда
		Возврат "Документ." + Сред(ИмяТипа, СтрДлина(ПрефиксДокумента) + 1);
	КонецЕсли;
	Возврат ИмяТипа;

КонецФункции

Функция ЭтоДопустимоеИмя(Имя)

	Если СтрДлина(Имя) < 1 ИЛИ СтрДлина(Имя) > 128 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Имя) Цикл
		Код = КодСимвола(Имя, Позиция);
		ЭтоБуква = (Код >= 65 И Код <= 90) ИЛИ (Код >= 97 И Код <= 122)
			ИЛИ (Код >= 1040 И Код <= 1103) ИЛИ Код = 1025 ИЛИ Код = 1105;
		ЭтоЦифра = (Код >= 48 И Код <= 57);
		Если Позиция = 1 И НЕ ЭтоБуква И Код <> 95 Тогда
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ЭтоБуква И НЕ ЭтоЦифра И Код <> 95 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ЭтоУИД(Значение) Экспорт

	Если СтрДлина(Значение) <> 36 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По 36 Цикл
		Символ = Сред(Значение, Позиция, 1);
		Если Позиция = 9 ИЛИ Позиция = 14 ИЛИ Позиция = 19 ИЛИ Позиция = 24 Тогда
			Если Символ <> "-" Тогда
				Возврат Ложь;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Код = КодСимвола(Значение, Позиция);
		Если НЕ ((Код >= 48 И Код <= 57) ИЛИ (Код >= 65 И Код <= 70) ИЛИ (Код >= 97 И Код <= 102)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ПроверитьИПодготовитьЗапрос(ТекстЗапроса) Экспорт

	Схема = Новый СхемаЗапроса;
	Попытка
		Схема.УстановитьТекстЗапроса(ТекстЗапроса);
	Исключение
		Диагностика = КраткоОбрезать(ТекстОписанияОшибки(ИнформацияОбОшибке()), 500);
		ВызватьИсключение ОшибкаСервиса("query_parse_error", "Запрос не прошёл разбор платформы: " + Диагностика);
	КонецПопытки;

	ПервыйДопуск = ПроверитьСхемуЗапроса(Схема);

	Попытка
		КаноническийТекст = Схема.ПолучитьТекстЗапроса();
	Исключение
		ВызватьИсключение ОшибкаСервиса("canonical_text_error", "Не удалось получить канонический текст запроса.");
	КонецПопытки;
	Если СокрЛП(КаноническийТекст) = "" Тогда
		ВызватьИсключение ОшибкаСервиса("canonical_text_error", "Канонический текст запроса пуст.");
	КонецЕсли;
	Если СтрДлина(КаноническийТекст) > ТвердыйМаксимум("maxQueryTextLength") Тогда
		ВызватьИсключение ОшибкаСервиса("query_text_too_long", "Канонический текст запроса превышает допустимую длину.");
	КонецЕсли;

	Запрет = НайтиЗапретБлокировки(КаноническийТекст);
	Если Запрет <> "" Тогда
		ВызватьИсключение ОшибкаСервиса("lock_not_allowed",
			"Конструкция блокировки запрещена в read-only сервисе: " + Запрет);
	КонецЕсли;

	Схема2 = Новый СхемаЗапроса;
	Попытка
		Схема2.УстановитьТекстЗапроса(КаноническийТекст);
	Исключение
		ВызватьИсключение ОшибкаСервиса("canonical_roundtrip_mismatch",
			"Канонический текст запроса не прошёл повторный разбор платформы.");
	КонецПопытки;
	ВторойДопуск = ПроверитьСхемуЗапроса(Схема2);
	Если ВторойДопуск.ИндексРезультата <> ПервыйДопуск.ИндексРезультата
		ИЛИ ВторойДопуск.ВсегоОператоров <> ПервыйДопуск.ВсегоОператоров Тогда
		ВызватьИсключение ОшибкаСервиса("canonical_roundtrip_mismatch",
			"Повторный разбор канонического текста дал другой пакет.");
	КонецЕсли;
	Попытка
		Текст2 = Схема2.ПолучитьТекстЗапроса();
	Исключение
		ВызватьИсключение ОшибкаСервиса("canonical_roundtrip_mismatch",
			"Не удалось получить канонический текст на повторном разборе.");
	КонецПопытки;
	Если Текст2 <> КаноническийТекст Тогда
		ВызватьИсключение ОшибкаСервиса("canonical_roundtrip_mismatch",
			"Канонический текст запроса нестабилен при повторном разборе.");
	КонецЕсли;
	Запрет2 = НайтиЗапретБлокировки(Текст2);
	Если Запрет2 <> "" Тогда
		ВызватьИсключение ОшибкаСервиса("lock_not_allowed",
			"Конструкция блокировки запрещена в read-only сервисе: " + Запрет2);
	КонецЕсли;

	Хеш = ХешТекстаSHA256(Текст2);
	Возврат Новый Структура(
		"КаноническийТекст,КаноническийХешSHA256,ИндексРезультата,ВсегоОператоров,ЭлементовПакета,ВременныеТаблицы,СозданныеТаблицы",
		Текст2, Хеш, ВторойДопуск.ИндексРезультата, ВторойДопуск.ВсегоОператоров,
		ВторойДопуск.ЭлементовПакета, ВторойДопуск.ВременныеТаблицы, ВторойДопуск.СозданныеТаблицы);

КонецФункции

Функция ПроверитьСхемуЗапроса(Схема)

	Пакет = Схема.ПакетЗапросов;
	Если ТипЗнч(Пакет) <> Тип("ПакетЗапросовСхемыЗапроса") Тогда
		ВызватьИсключение ОшибкаСервиса("unsupported_packet", "Схема запроса не содержит пакета запросов.");
	КонецЕсли;
	Элементов = Пакет.Количество();
	Если Элементов < 1 Тогда
		ВызватьИсключение ОшибкаСервиса("unsupported_packet", "Пакет запросов пуст.");
	КонецЕсли;
	Если Элементов > 32 Тогда
		ВызватьИсключение ОшибкаСервиса("traversal_limit", "Пакет содержит слишком много элементов.");
	КонецЕсли;

	Состояние = Новый Структура;
	Состояние.Вставить("ВсегоОператоров", 0);
	Состояние.Вставить("Узлов", 0);
	Состояние.Вставить("СозданныеТаблицы", Новый Соответствие);
	Состояние.Вставить("АктивныеТаблицы", Новый Соответствие);
	Состояние.Вставить("ИндексРезультата", -1);

	Для ИндексЭлемента = 0 По Элементов - 1 Цикл
		Элемент = Пакет.Получить(ИндексЭлемента);
		ТипЭлемента = ТипЗнч(Элемент);
		Если ТипЭлемента = Тип("ЗапросВыбораСхемыЗапроса") Тогда
			Если НЕ Элемент.ВыбиратьРазрешенные Тогда
				ВызватьИсключение ОшибкаСервиса("allowed_select_required",
					"Каждый самостоятельный SELECT пакета должен содержать РАЗРЕШЕННЫЕ.");
			КонецЕсли;
			ИмяПомещения = ВРег(СокрЛП(Элемент.ТаблицаДляПомещения));
			ИмяДобавления = ВРег(СокрЛП(Элемент.ТаблицаДляДобавления));
			Если ИмяДобавления <> "" Тогда
				// ДОБАВИТЬ во временную таблицу вне bounded read-scope.
				ВызватьИсключение ОшибкаСервиса("unsupported_temp_table_add",
					"ДОБАВИТЬ во временную таблицу не поддерживается: " + ИмяДобавления);
			КонецЕсли;
			Если ИмяПомещения <> "" Тогда
				Если Состояние.СозданныеТаблицы.Получить(ИмяПомещения) <> Неопределено Тогда
					ВызватьИсключение ОшибкаСервиса("duplicate_temp_table",
						"Временная таблица создаётся повторно: " + ИмяПомещения);
				КонецЕсли;
				Состояние.СозданныеТаблицы.Вставить(ИмяПомещения, Истина);
				Состояние.АктивныеТаблицы.Вставить(ИмяПомещения, Истина);
			КонецЕсли;
			Если ИмяПомещения = "" Тогда
				Состояние.ИндексРезультата = ИндексЭлемента;
			КонецЕсли;
			Операторы = Элемент.Операторы;
			Если Операторы.Количество() < 1 Тогда
				ВызватьИсключение ОшибкаСервиса("unsupported_packet", "SELECT-элемент без операторов.");
			КонецЕсли;
			Для ИндексОператора = 0 По Операторы.Количество() - 1 Цикл
				ПроверитьОператор(Операторы.Получить(ИндексОператора), 1, Состояние);
				Состояние.ВсегоОператоров = Состояние.ВсегоОператоров + 1;
			КонецЦикла;
		ИначеЕсли ТипЭлемента = Тип("ЗапросУничтоженияТаблицыСхемыЗапроса") Тогда
			ИмяУничтожения = ВРег(СокрЛП(Элемент.ИмяТаблицы));
			Если ИмяУничтожения = "" Тогда
				ВызватьИсключение ОшибкаСервиса("unknown_temp_table_destroy", "УНИЧТОЖИТЬ без имени таблицы.");
			КонецЕсли;
			Если Состояние.СозданныеТаблицы.Получить(ИмяУничтожения) = Неопределено Тогда
				ВызватьИсключение ОшибкаСервиса("unknown_temp_table_destroy",
					"УНИЧТОЖИТЬ разрешено только для временной таблицы, созданной этим запросом: " + ИмяУничтожения);
			КонецЕсли;
			Если Состояние.АктивныеТаблицы.Получить(ИмяУничтожения) = Неопределено Тогда
				ВызватьИсключение ОшибкаСервиса("duplicate_temp_table_destroy",
					"Повторное УНИЧТОЖИТЬ временной таблицы: " + ИмяУничтожения);
			КонецЕсли;
			Состояние.АктивныеТаблицы.Удалить(ИмяУничтожения);
		Иначе
			ВызватьИсключение ОшибкаСервиса("unsupported_packet_element",
				"Неподдерживаемый элемент пакета запросов: " + Строка(ТипЭлемента));
		КонецЕсли;
	КонецЦикла;

	Если Состояние.ИндексРезультата < 0 Тогда
		ВызватьИсключение ОшибкаСервиса("no_result_select",
			"Пакет не содержит SELECT, возвращающего результат (только ПОМЕСТИТЬ/УНИЧТОЖИТЬ не поддерживается).");
	КонецЕсли;

	Активные = Новый Массив;
	Для Каждого КЗ Из Состояние.АктивныеТаблицы Цикл
		Активные.Добавить(Строка(КЗ.Ключ));
	КонецЦикла;
	Созданные = Новый Массив;
	Для Каждого КЗ Из Состояние.СозданныеТаблицы Цикл
		Созданные.Добавить(Строка(КЗ.Ключ));
	КонецЦикла;

	Возврат Новый Структура(
		"ИндексРезультата,ВсегоОператоров,ЭлементовПакета,ВременныеТаблицы,СозданныеТаблицы",
		Состояние.ИндексРезультата, Состояние.ВсегоОператоров, Элементов, Активные, Созданные);

КонецФункции

Процедура ПроверитьОператор(Оператор, Глубина, Состояние)

	Если Глубина > 8 Тогда
		ВызватьИсключение ОшибкаСервиса("traversal_limit", "Превышена максимальная глубина обхода запроса.");
	КонецЕсли;
	Состояние.Узлов = Состояние.Узлов + 1;
	Если Состояние.Узлов > 500 Тогда
		ВызватьИсключение ОшибкаСервиса("traversal_limit", "Превышено максимальное число узлов обхода запроса.");
	КонецЕсли;
	Если ТипЗнч(Оператор) <> Тип("ОператорВыбратьСхемыЗапроса") Тогда
		ВызватьИсключение ОшибкаСервиса("unsupported_operator",
			"Неподдерживаемый оператор запроса: " + Строка(ТипЗнч(Оператор)));
	КонецЕсли;
	Если Оператор.ВыбиратьДляИзменения Тогда
		ВызватьИсключение ОшибкаСервиса("lock_not_allowed", "Оператор содержит ДЛЯ ИЗМЕНЕНИЯ.");
	КонецЕсли;
	Если Оператор.ТаблицыДляИзменения.Количество() > 0 Тогда
		ВызватьИсключение ОшибкаСервиса("lock_not_allowed", "Оператор содержит ТаблицыДляИзменения.");
	КонецЕсли;
	Источники = Оператор.Источники;
	Для ИндексИсточника = 0 По Источники.Количество() - 1 Цикл
		Источник = Источники.Получить(ИндексИсточника);
		Если ТипЗнч(Источник) <> Тип("ИсточникСхемыЗапроса") Тогда
			ВызватьИсключение ОшибкаСервиса("unsupported_source",
				"Неподдерживаемый элемент источников: " + Строка(ТипЗнч(Источник)));
		КонецЕсли;
		Внутренний = Источник.Источник;
		ТипВнутреннего = ТипЗнч(Внутренний);
		Если ТипВнутреннего = Тип("ВложенныйЗапросСхемыЗапроса") Тогда
			ПроверитьВложенныйЗапрос(Внутренний.Запрос, Глубина + 1, Состояние);
		ИначеЕсли ТипВнутреннего = Тип("ТаблицаСхемыЗапроса") Тогда
			Состояние.Узлов = Состояние.Узлов + 1;
		ИначеЕсли ТипВнутреннего = Тип("ОписаниеВременнойТаблицыСхемыЗапроса") Тогда
			Состояние.Узлов = Состояние.Узлов + 1;
		Иначе
			ВызватьИсключение ОшибкаСервиса("unsupported_source",
				"Неподдерживаемый источник запроса: " + Строка(ТипВнутреннего));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьВложенныйЗапрос(Вложенный, Глубина, Состояние)

	Если Вложенный = Неопределено Тогда
		ВызватьИсключение ОшибкаСервиса("unsupported_source", "Вложенный запрос отсутствует.");
	КонецЕсли;
	Если ТипЗнч(Вложенный) <> Тип("ЗапросВыбораСхемыЗапроса") Тогда
		ВызватьИсключение ОшибкаСервиса("unsupported_source", "Неподдерживаемый вложенный запрос.");
	КонецЕсли;
	Если СокрЛП(Вложенный.ТаблицаДляПомещения) <> "" ИЛИ СокрЛП(Вложенный.ТаблицаДляДобавления) <> "" Тогда
		ВызватьИсключение ОшибкаСервиса("unsupported_source", "Вложенный запрос не может создавать временную таблицу.");
	КонецЕсли;
	Операторы = Вложенный.Операторы;
	Если Операторы.Количество() < 1 Тогда
		ВызватьИсключение ОшибкаСервиса("unsupported_source", "Вложенный запрос без операторов.");
	КонецЕсли;
	Для ИндексОператора = 0 По Операторы.Количество() - 1 Цикл
		ПроверитьОператор(Операторы.Получить(ИндексОператора), Глубина, Состояние);
		Состояние.ВсегоОператоров = Состояние.ВсегоОператоров + 1;
	КонецЦикла;

КонецПроцедуры

Функция НайтиЗапретБлокировки(Текст)

	Длина = СтрДлина(Текст);
	Позиция = 1;
	ПредыдущееСлово = "";
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = """" Тогда
			Позиция = Позиция + 1;
			Пока Позиция <= Длина Цикл
				Текущий = Сред(Текст, Позиция, 1);
				Если Текущий = """" Тогда
					Если Позиция < Длина И Сред(Текст, Позиция + 1, 1) = """" Тогда
						Позиция = Позиция + 2;
					Иначе
						Позиция = Позиция + 1;
						Прервать;
					КонецЕсли;
				Иначе
					Позиция = Позиция + 1;
				КонецЕсли;
			КонецЦикла;
			ПредыдущееСлово = "";
		ИначеЕсли Символ = "/" И Позиция < Длина И Сред(Текст, Позиция + 1, 1) = "/" Тогда
			Позиция = Позиция + 2;
			Пока Позиция <= Длина Цикл
				Текущий = Сред(Текст, Позиция, 1);
				Если Текущий = Символы.ПС ИЛИ Текущий = Символы.ВК Тогда
					Прервать;
				КонецЕсли;
				Позиция = Позиция + 1;
			КонецЦикла;
			// Комментарий не разрывает соседние ключевые слова.
		ИначеЕсли ЭтоСимволСлова(Символ) Тогда
			Начало = Позиция;
			Пока Позиция <= Длина Цикл
				Если ЭтоСимволСлова(Сред(Текст, Позиция, 1)) Тогда
					Позиция = Позиция + 1;
				Иначе
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Слово = ВРег(Сред(Текст, Начало, Позиция - Начало));
			Если Слово = "ИЗМЕНЕНИЯ" И ПредыдущееСлово = "ДЛЯ" Тогда
				Возврат "ДЛЯ ИЗМЕНЕНИЯ";
			ИначеЕсли Слово = "UPDATE" И ПредыдущееСлово = "FOR" Тогда
				Возврат "FOR UPDATE";
			КонецЕсли;
			ПредыдущееСлово = Слово;
		Иначе
			Если НЕ ЭтоПробельныйСимвол(Символ) Тогда
				ПредыдущееСлово = "";
			КонецЕсли;
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ЭтоСимволСлова(Символ)

	Код = КодСимвола(Символ, 1);
	Возврат (Код >= 48 И Код <= 57) ИЛИ (Код >= 65 И Код <= 90) ИЛИ (Код >= 97 И Код <= 122)
		ИЛИ Код = 95 ИЛИ (Код >= 1040 И Код <= 1103) ИЛИ Код = 1025 ИЛИ Код = 1105;

КонецФункции

Функция ЭтоПробельныйСимвол(Символ)

	Возврат Символ = " " ИЛИ Символ = Символы.Таб ИЛИ Символ = Символы.ПС ИЛИ Символ = Символы.ВК;

КонецФункции

Функция ТекстОписанияОшибки(Информация) Экспорт

	Попытка
		Возврат Информация.Описание;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция ХешТекстаSHA256(Текст) Экспорт

	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8));
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));

КонецФункции
