Функция ИзвлечьФорматВывода(Корпус)

	Вывод = Корпус.Получить("output");
	Если Вывод = Неопределено Тогда
		Возврат "json";
	КонецЕсли;
	Если ТипЗнч(Вывод) <> Тип("Соответствие") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_request", "Поле output должно быть объектом.");
	КонецЕсли;
	Формат = Вывод.Получить("format");
	Если Формат = Неопределено Тогда
		Возврат "json";
	КонецЕсли;
	Если ТипЗнч(Формат) <> Тип("Строка") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_format", "Поле output.format должно быть строкой.");
	КонецЕсли;
	Нормализованный = НРег(СокрЛП(Формат));
	Если Нормализованный <> "json" И Нормализованный <> "csv" Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_format", "Поддерживаются форматы json и csv.");
	КонецЕсли;
	Возврат Нормализованный;

КонецФункции

Функция ИзвлечьПараметры(Корпус)

	Параметры = Корпус.Получить("parameters");
