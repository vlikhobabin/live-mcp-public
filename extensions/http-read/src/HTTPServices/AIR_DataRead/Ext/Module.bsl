Функция ЛимитыЗапроса(Корпус)

	Запрошенные = Новый Соответствие;
	Лимиты = Корпус.Получить("limits");
	Если Лимиты <> Неопределено Тогда
		Если ТипЗнч(Лимиты) <> Тип("Соответствие") Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_limits", "Поле limits должно быть объектом.");
		КонецЕсли;
		Для Каждого КЗ Из Лимиты Цикл
			Имя = Строка(КЗ.Ключ);
			Если Имя = "maxRows" ИЛИ Имя = "maxColumns" ИЛИ Имя = "maxCells" ИЛИ Имя = "maxResponseBytes" Тогда
				Значение = КЗ.Значение;
				Если ТипЗнч(Значение) <> Тип("Число") ИЛИ Значение <> Цел(Значение) ИЛИ Значение < 1 Тогда
					ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_limits", "Значение limits." + Имя + " должно быть положительным целым.");
				КонецЕсли;
				Запрошенные.Вставить(Имя, Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Эффективные = Новый Структура;
	Эффективные.Вставить("maxRows", ПределПоЗапросу(Запрошенные, "maxRows"));
	Эффективные.Вставить("maxColumns", ПределПоЗапросу(Запрошенные, "maxColumns"));
	Эффективные.Вставить("maxCells", ПределПоЗапросу(Запрошенные, "maxCells"));
	Эффективные.Вставить("maxResponseBytes", ПределПоЗапросу(Запрошенные, "maxResponseBytes"));
	Эффективные.Вставить("requested", Новый Структура);
	Для Каждого КЗ Из Запрошенные Цикл
		Эффективные.requested.Вставить(Строка(КЗ.Ключ), КЗ.Значение);
	КонецЦикла;
	Эффективные.Вставить("hardCaps", AIR_ReadCore.ТвердыеМаксимумы());
	Эффективные.Вставить("scope", "per_request_response_shape");
	Эффективные.Вставить("serverEnforced", Истина);
	Эффективные.Вставить("executionTimeoutSupported", Ложь);
	Эффективные.Вставить("timeoutCancelsServerExecution", Ложь);
	Возврат Эффективные;

КонецФункции

Функция ПределПоЗапросу(Запрошенные, Имя)

	Максимум = AIR_ReadCore.ТвердыйМаксимум(Имя);
	Значение = Запрошенные.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат Максимум;
	КонецЕсли;
	Возврат Мин(Значение, Максимум);

КонецФункции



Процедура ПроверитьРазмерОтвета(Текст, Лимиты)

	Размер = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8).Размер();
	Если Размер > Лимиты.maxResponseBytes Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("response_limit_exceeded",
			"Ответ превышает допустимый размер; уменьшите maxRows/maxColumns или набор колонок.");
	КонецЕсли;

КонецПроцедуры

