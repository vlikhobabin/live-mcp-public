////////////////////////////////////////////////////////////////////////////////
// Модуль HTTP-сервиса AIR_DataRead расширения AIDataRead.
//
// Назначение: собственный нейтральный read-only сервис:
//   GET  /hs/ai-data-read/ping/              - доступность
//   GET  /hs/ai-data-read/info/              - контракт и ограничения
//   POST /hs/ai-data-read/v1/query/validate/ - разбор и допуск без выполнения
//   POST /hs/ai-data-read/v1/query/execute/  - выполнение проверенного пакета
//   POST /hs/ai-data-read/v1/dcs/execute/    - безопасный СКД в коллекцию значений
//   POST /hs/ai-data-read/v1/dcs/render/     - безопасный СКД в табличный документ
//
// Инварианты:
//   * нет обработчиков записи, административных, файловых, startup-процедур;
//   * исполняется только канонический текст, дважды разобранный платформой,
//     прошедший ограниченный обход известного AST и узкий лексер запрета
//     блокировок; неизвестные узлы/источники/элементы пакета отклоняются;
//   * ВыбиратьРазрешенные = Истина требуется у каждого самостоятельного
//     SELECT-элемента пакета; у вложенных запросов и ветвей ОБЪЕДИНИТЬ этот
//     флаг синтаксически недопустим и не требуется;
//   * у всех операторов проверяется ВыбиратьДляИзменения и ТаблицыДляИзменения
//     независимо от того, заполнены ли таблицы блокировки;
//   * МенеджерВременныхТаблиц создаётся на запрос; УНИЧТОЖИТЬ разрешён только
//     для таблиц, созданных этим же запросом; менеджер закрывается на обоих
//     исходах, ошибка закрытия не маскирует основную ошибку;
//   * effectiveUser - аутентифицированный пользователь ИБ платформы;
//     requestedUser - диагностический hint и не меняет пользователя;
//   * лимиты ответа - конечные ограничения формы ответа этого сервиса, а не
//     квоты платформы; принудительного execution timeout/cancel нет;
//   * СКД исполняется только после проверки поддержанного schema/settings graph,
//     применения типизированных параметров ДО compile и полного допуска всех
//     фактически исполняемых query texts скомпонованного макета; после полного
//     допуска в набор назначается проверенный canonical text (setter+readback
//     до Initialize), новых settings/compile transforms нет;
//   * новый DCS root принимает только JSON envelope schemaVersion=1; raw XML
//     явно отвергается, CSV отдаётся только полем внутри JSON-конверта;
//   * у процессора СКД внешние функции отключены, ссылочные поля ограничены
//     правом Просмотр.
////////////////////////////////////////////////////////////////////////////////

Функция Пинг(Запрос) Экспорт

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Данные = Новый Структура;
	Данные.Вставить("success", Истина);
	Данные.Вставить("service", "ai-data-read");
	Данные.Вставить("status", "ok");
	Данные.Вставить("version", ВерсияСервиса());
	Данные.Вставить("utc", Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyy-MM-dd HH:mm:ss"));
	Данные.Вставить("timings", Новый Структура("totalMs", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс));
	Возврат ОтветJSON(200, Данные);

КонецФункции

Функция Информация(Запрос) Экспорт

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Данные = Новый Структура;
	Данные.Вставить("success", Истина);
	Данные.Вставить("service", "ai-data-read");
	Данные.Вставить("version", ВерсияСервиса());
	Данные.Вставить("specVersion", 1);
	Данные.Вставить("vendor", "ai for 1c");
	Данные.Вставить("compatibilityMode", "8.3.27");
	Система = Новый СистемнаяИнформация;
	Данные.Вставить("platformVersion", Система.ВерсияПриложения);

	КонечныеТочки = Новый Массив;
	КонечныеТочки.Добавить(НоваяКонечнаяТочка("GET", "/ping/", "Проверка доступности сервиса"));
	КонечныеТочки.Добавить(НоваяКонечнаяТочка("GET", "/info/", "Служебная информация и контракт"));
	КонечныеТочки.Добавить(НоваяКонечнаяТочка("POST", "/v1/query/validate/", "Разбор и допуск запроса без выполнения"));
	КонечныеТочки.Добавить(НоваяКонечнаяТочка("POST", "/v1/query/execute/", "Выполнение проверенного read-only пакета"));
	КонечныеТочки.Добавить(НоваяКонечнаяТочка("POST", "/v1/dcs/execute/", "Выполнение проверенной XML-схемы СКД в коллекцию значений"));
	КонечныеТочки.Добавить(НоваяКонечнаяТочка("POST", "/v1/dcs/render/", "Вывод проверенной XML-схемы СКД в табличный документ"));
	Данные.Вставить("endpoints", КонечныеТочки);

	Аутентификация = Новый Структура;
	Аутентификация.Вставить("mode", "platform_authenticated_user");
	Аутентификация.Вставить("requestedUserRole", "diagnostic_request_hint");
	Аутентификация.Вставить("requestedUserApplied", Ложь);
	Аутентификация.Вставить("requestedUserIsImpersonation", Ложь);
	Данные.Вставить("auth", Аутентификация);

	Лимиты = Новый Структура;
	Лимиты.Вставить("scope", "per_request_response_shape");
	Лимиты.Вставить("hardCaps", AIR_ReadCore.ТвердыеМаксимумы());
	Лимиты.Вставить("executionTimeout", Новый Структура("supported,timeoutCancelsServerExecution", Ложь, Ложь));
	Лимиты.Вставить("note", "Конечные ограничения формы ответа сервиса, не квоты платформы и не memory quota.");
	Данные.Вставить("limits", Лимиты);

	Допуск = Новый Структура;
	Допуск.Вставить("language", "1c");
	Допуск.Вставить("requireAllowedSelectPerPacketSelect", Истина);
	Допуск.Вставить("forbidUpdateLockKeywords", Новый Структура("ru,en", "ДЛЯ ИЗМЕНЕНИЯ", "FOR UPDATE"));
	Допуск.Вставить("unknownConstructs", "reject");
	Допуск.Вставить("canonicalTextExecuted", Истина);
	Допуск.Вставить("tempTables", "request_owned_manager");
	Допуск.Вставить("dcsSubset", "one_local_query_dataset,typed_parameters,selection,groups,SUM/COUNT,order");
	Допуск.Вставить("dcsFilterPolicy", "schema_level_simple_filter_admitted; generated_dataset_filter_rejected_until_qualified");
	Допуск.Вставить("dcsWire", "universal-v1_json_only");
	Допуск.Вставить("dcsRawXml", Ложь);
	Допуск.Вставить("dcsCanonicalTextAppliedBeforeInitialize", Истина);
	Допуск.Вставить("dcsExternalFunctions", Ложь);
	Допуск.Вставить("dcsReferenceFieldsByViewRight", Истина);
	Допуск.Вставить("dcsUnsupported", "object/union/nested datasets,dataset_links,calculated_fields,user_fields,conditional_appearance,custom_templates");
	Данные.Вставить("admission", Допуск);

	Возможности = Новый Структура;
	Возможности.Вставить("query", Истина);
	Возможности.Вставить("dcs", Истина);
	Возможности.Вставить("files", Ложь);
	Возможности.Вставить("writes", Ложь);
	Возможности.Вставить("bsl", Ложь);
	Возможности.Вставить("startup", Ложь);
	Данные.Вставить("capabilities", Возможности);
	Данные.Вставить("timings", Новый Структура("totalMs", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс));
	Возврат ОтветJSON(200, Данные);

КонецФункции

Функция ПроверитьЗапрос(Запрос) Экспорт

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИдентификаторКорреляции = "";
	Попытка
		Корпус = ПрочитатьТелоЗапроса(Запрос);
		ИдентификаторКорреляции = ИзвлечьИдентификаторКорреляции(Корпус);
		ТекстЗапроса = ИзвлечьТекстЗапроса(Корпус);
		МассивПараметров = ИзвлечьПараметры(Корпус);
		ЭффективныеЛимиты = ЛимитыЗапроса(Корпус);
		RequestedUser = ИзвлечьRequestedUser(Корпус);
		НачалоРазбораМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Проверка = AIR_ReadCore.ПроверитьИПодготовитьЗапрос(ТекстЗапроса);
		КонецРазбораМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Параметры = AIR_ReadCore.ПреобразоватьПараметры(МассивПараметров);

		Данные = Новый Структура;
		Данные.Вставить("success", Истина);
		Данные.Вставить("service", "ai-data-read");
		Данные.Вставить("mode", "query-validate");
		ВставитьКорреляцию(Данные, ИдентификаторКорреляции);
		ЗаполнитьПользователей(Данные, RequestedUser);
		Данные.Вставить("validationStatus", "passed");
		Данные.Вставить("parameters", AIR_ReadCore.ПредставлениеПараметров(Параметры));
		Данные.Вставить("query", Новый Структура(
			"language,textLength,canonicalTextLength,canonicalTextSha256,requestedHash",
			"1c", СтрДлина(ТекстЗапроса), СтрДлина(Проверка.КаноническийТекст),
			Проверка.КаноническийХешSHA256, ИзвлечьЗапрошенныйХеш(Корпус)));
		Данные.Вставить("admission", ПредставлениеДопуска(Проверка));
		Данные.Вставить("limits", ЭффективныеЛимиты);
		Данные.Вставить("timings", Новый Структура(
			"parseMs,totalMs", КонецРазбораМс - НачалоРазбораМс, ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс));
		ТекстОтвета = AIR_ReadCore.ТекстJSON(Данные);
		ПроверитьРазмерОтвета(ТекстОтвета, ЭффективныеЛимиты);
		Возврат ОтветJSONИзТекста(200, ТекстОтвета);
	Исключение
		Возврат ОтветИзИсключения(ИнформацияОбОшибке(), ИдентификаторКорреляции);
	КонецПопытки;

КонецФункции

Функция ВыполнитьЗапрос(Запрос) Экспорт

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИдентификаторКорреляции = "";
	Попытка
		Корпус = ПрочитатьТелоЗапроса(Запрос);
		ИдентификаторКорреляции = ИзвлечьИдентификаторКорреляции(Корпус);
		ТекстЗапроса = ИзвлечьТекстЗапроса(Корпус);
		ФорматВывода = ИзвлечьФорматВывода(Корпус);
		МассивПараметров = ИзвлечьПараметры(Корпус);
		ЭффективныеЛимиты = ЛимитыЗапроса(Корпус);
		RequestedUser = ИзвлечьRequestedUser(Корпус);
		НачалоРазбораМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Проверка = AIR_ReadCore.ПроверитьИПодготовитьЗапрос(ТекстЗапроса);
		КонецРазбораМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Параметры = AIR_ReadCore.ПреобразоватьПараметры(МассивПараметров);
		Результат = ВыполнитьПроверенныйЗапрос(Проверка, Параметры, ЭффективныеЛимиты);
		КонецВыполненияМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

		Данные = Новый Структура;
		Данные.Вставить("success", Истина);
		Данные.Вставить("service", "ai-data-read");
		Данные.Вставить("mode", "query-execute");
		ВставитьКорреляцию(Данные, ИдентификаторКорреляции);
		ЗаполнитьПользователей(Данные, RequestedUser);
		Данные.Вставить("query", Новый Структура(
			"language,textLength,canonicalTextLength,canonicalTextSha256,requestedHash",
			"1c", СтрДлина(ТекстЗапроса), СтрДлина(Проверка.КаноническийТекст),
			Проверка.КаноническийХешSHA256, ИзвлечьЗапрошенныйХеш(Корпус)));
		Данные.Вставить("admission", ПредставлениеДопуска(Проверка));
		Данные.Вставить("parameters", AIR_ReadCore.ПредставлениеПараметров(Параметры));
		Данные.Вставить("limits", ЭффективныеЛимиты);
		Данные.Вставить("timings", Новый Структура(
			"parseMs,executeMs,totalMs",
			КонецРазбораМс - НачалоРазбораМс,
			КонецВыполненияМс - КонецРазбораМс,
			ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс));
		Данные.Вставить("result", Результат.Значения);
		Данные.Вставить("rowCount", Результат.СтрокВозвращено);
		Данные.Вставить("truncated", Результат.Обрезано);
		Данные.Вставить("columns", Результат.Колонки);
		Данные.Вставить("warnings", Новый Массив);

		Если ФорматВывода = "csv" Тогда
			Данные.result.Вставить("csv", СформироватьCSV(Результат));
		КонецЕсли;

		ТекстОтвета = AIR_ReadCore.ТекстJSON(Данные);
		ПроверитьРазмерОтвета(ТекстОтвета, ЭффективныеЛимиты);
		Возврат ОтветJSONИзТекста(200, ТекстОтвета);
	Исключение
		Возврат ОтветИзИсключения(ИнформацияОбОшибке(), ИдентификаторКорреляции);
	КонецПопытки;

КонецФункции

Функция ВыполнитьСхемуКомпоновки(Запрос) Экспорт

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИдентификаторКорреляции = "";
	Попытка
		ТелоТекст = ПрочитатьТелоЗапросаКакТекст(Запрос, "maxDcsRequestBytes");
		ЗапросDcs = ПодготовитьЗапросDcsУниверсальный(ТелоТекст);
		ИдентификаторКорреляции = ЗапросDcs.correlationId;
		ЭффективныеЛимиты = ЛимитыDcs(ЗапросDcs.Корпус, "execute");
		НачалоРазбораМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Проверка = AIR_DcsExecution.ПрочитатьИПроверитьСхему(ЗапросDcs.schemaXml);
		КонецРазбораМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Параметры = AIR_ReadCore.ПреобразоватьПараметры(ЗапросDcs.parameters);
		НачалоКомпоновкиМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Компоновщик = AIR_DcsExecution.СоздатьКомпоновщикНастроек(Проверка.Схема);
		AIR_DcsExecution.ПрименитьПараметры(Компоновщик, Параметры, Проверка.Сведения.parameterNames);
		Макет = AIR_DcsExecution.ПостроитьМакетДляКоллекции(Проверка.Схема, Компоновщик.Настройки);
		Подготовка = AIR_DcsExecution.ПодготовитьПроцессорПоМакету(Макет);
		КонецКомпоновкиМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		НачалоВыполненияМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Таблица = AIR_DcsExecution.ВыполнитьВКоллекцию(Подготовка.processor);
		Вывод = AIR_DcsOutput.СформироватьКоллекцию(Таблица, ЭффективныеЛимиты);
		КонецВыполненияМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

		Данные = Новый Структура;
		Данные.Вставить("success", Истина);
		Данные.Вставить("service", "ai-data-read");
		Данные.Вставить("version", ВерсияСервиса());
		Данные.Вставить("mode", "dcs-execute");
		Данные.Вставить("schemaSource", "universal-v1");
		Данные.Вставить("schemaVersion", 1);
		ВставитьКорреляцию(Данные, ИдентификаторКорреляции);
		ЗаполнитьПользователей(Данные, ЗапросDcs.requestedUser);
		Данные.Вставить("schema", СформироватьСводкуСхемы(Проверка));
		Данные.Вставить("admission", СформироватьДопускDcs(Подготовка.admission));
		Данные.Вставить("parameters", AIR_ReadCore.ПредставлениеПараметров(Параметры));
		Данные.Вставить("limits", ЭффективныеЛимиты);
		Данные.Вставить("timings", Новый Структура(
			"parseMs,compileMs,executeMs,totalMs",
			КонецРазбораМс - НачалоРазбораМс,
			КонецКомпоновкиМс - НачалоКомпоновкиМс,
			КонецВыполненияМс - НачалоВыполненияМс,
			ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс));
		Данные.Вставить("result", Вывод.Значения);
		Данные.Вставить("rows", Вывод.Значения.rows);
		Данные.Вставить("rowCount", Вывод.СтрокВозвращено);
		Данные.Вставить("truncated", Вывод.Обрезано);
		Данные.Вставить("columns", Вывод.Колонки);
		Данные.Вставить("fullResultRows", Вывод.ВсегоСтрок);
		Данные.Вставить("warnings", Новый Массив);
		Данные.Вставить("diagnostics", Новый Массив);
		Если ЗапросDcs.format = "csv" Тогда
			Данные.Вставить("csv", СформироватьCSV(Вывод));
		КонецЕсли;

		ТекстОтвета = AIR_ReadCore.ТекстJSON(Данные);
		ПроверитьРазмерОтвета(ТекстОтвета, ЭффективныеЛимиты);
		Возврат ОтветJSONИзТекста(200, ТекстОтвета);
	Исключение
		Возврат ОтветИзИсключения(ИнформацияОбОшибке(), ИдентификаторКорреляции);
	КонецПопытки;

КонецФункции

Функция РендерСхемуКомпоновки(Запрос) Экспорт

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИдентификаторКорреляции = "";
	Попытка
		ТелоТекст = ПрочитатьТелоЗапросаКакТекст(Запрос, "maxDcsRequestBytes");
		ЗапросDcs = ПодготовитьЗапросDcsУниверсальный(ТелоТекст);
		ИдентификаторКорреляции = ЗапросDcs.correlationId;
		ЭффективныеЛимиты = ЛимитыDcs(ЗапросDcs.Корпус, "render");
		НачалоРазбораМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Проверка = AIR_DcsExecution.ПрочитатьИПроверитьСхему(ЗапросDcs.schemaXml);
		КонецРазбораМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Параметры = AIR_ReadCore.ПреобразоватьПараметры(ЗапросDcs.parameters);
		НачалоКомпоновкиМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Компоновщик = AIR_DcsExecution.СоздатьКомпоновщикНастроек(Проверка.Схема);
		AIR_DcsExecution.ПрименитьПараметры(Компоновщик, Параметры, Проверка.Сведения.parameterNames);
		Макет = AIR_DcsExecution.ПостроитьМакетДляТабличногоДокумента(Проверка.Схема, Компоновщик.Настройки);
		Подготовка = AIR_DcsExecution.ПодготовитьПроцессорПоМакету(Макет);
		КонецКомпоновкиМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		НачалоВыполненияМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Документ = AIR_DcsExecution.ВыполнитьВТабличныйДокумент(Подготовка.processor);
		Извлечение = AIR_DcsOutput.СформироватьТабличныйДокумент(Документ, ЭффективныеЛимиты);
		Preview = AIR_DcsOutput.СформироватьPreviewMarkdown(Извлечение, ЭффективныеЛимиты);
		РезультатАртефактов = AIR_DcsOutput.СформироватьАртефакты(
			Документ, ЗапросDcs.artifacts, ЗапросDcs.reportId, ЭффективныеЛимиты);
		КонецВыполненияМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

		Данные = Новый Структура;
		Данные.Вставить("success", Истина);
		Данные.Вставить("service", "ai-data-read");
		Данные.Вставить("version", ВерсияСервиса());
		Данные.Вставить("mode", "dcs-render");
		Данные.Вставить("renderStatus", "passed");
		Данные.Вставить("schemaVersion", 1);
		Данные.Вставить("schemaSource", "universal-v1");
		Данные.Вставить("reportId", ЗапросDcs.reportId);
		ВставитьКорреляцию(Данные, ИдентификаторКорреляции);
		ЗаполнитьПользователей(Данные, ЗапросDcs.requestedUser);
		Данные.Вставить("schema", СформироватьСводкуСхемы(Проверка));
		Данные.Вставить("admission", СформироватьДопускDcs(Подготовка.admission));
		Данные.Вставить("parameters", AIR_ReadCore.ПредставлениеПараметров(Параметры));
		Данные.Вставить("limits", ЭффективныеЛимиты);
		Данные.Вставить("timings", Новый Структура(
			"parseMs,compileMs,renderMs,totalMs",
			КонецРазбораМс - НачалоРазбораМс,
			КонецКомпоновкиМс - НачалоКомпоновкиМс,
			КонецВыполненияМс - НачалоВыполненияМс,
			ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс));
		Данные.Вставить("tableDocument", Извлечение);
		Данные.Вставить("previewMarkdown", Preview);
		Данные.Вставить("artifacts", РезультатАртефактов.artifacts);
		Данные.Вставить("diagnostics", РезультатАртефактов.diagnostics);
		Данные.Вставить("warnings", Новый Массив);
		Данные.Вставить("fullResultRows", Извлечение.rowCount);

		ТекстОтвета = AIR_ReadCore.ТекстJSON(Данные);
		Если ПолучитьДвоичныеДанныеИзСтроки(ТекстОтвета, КодировкаТекста.UTF8).Размер()
			> ЭффективныеЛимиты.maxResponseBytes Тогда
			Пока Данные.artifacts.Количество() > 0 Цикл
				Артефакт = Данные.artifacts.Получить(Данные.artifacts.Количество() - 1);
				Данные.artifacts.Удалить(Данные.artifacts.Количество() - 1);
				Данные.diagnostics.Добавить(AIR_DcsOutput.НоваяДиагностика(
					"response_too_large", Артефакт.format,
					"Артефакт исключён из ответа: итоговый JSON превышает maxResponseBytes.",
					Неопределено, ЭффективныеЛимиты.maxResponseBytes, Неопределено));
				ТекстОтвета = AIR_ReadCore.ТекстJSON(Данные);
				Если ПолучитьДвоичныеДанныеИзСтроки(ТекстОтвета, КодировкаТекста.UTF8).Размер()
					<= ЭффективныеЛимиты.maxResponseBytes Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ПроверитьРазмерОтвета(ТекстОтвета, ЭффективныеЛимиты);
		Возврат ОтветJSONИзТекста(200, ТекстОтвета);
	Исключение
		Возврат ОтветИзИсключения(ИнформацияОбОшибке(), ИдентификаторКорреляции);
	КонецПопытки;

КонецФункции

Функция ПодготовитьЗапросDcsУниверсальный(ТелоТекст)

	// Новый DCS root — JSON-only. Raw XML/другой не-JSON корень явно
	// отвергается до разбора схемы; legacy-профиль старого endpoint сюда не
	// подмешивается.
	ТелоДляПроверки = СокрЛП(СтрЗаменить(ТелоТекст, Символ(65279), ""));
	Если Лев(ТелоДляПроверки, 1) = "<" Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("legacy_raw_xml_not_supported",
			"Raw XML не поддерживается новым DCS-контуром; используйте JSON-конверт schemaVersion=1.");
	КонецЕсли;
	Корпус = РазобратьТелоЗапросаJSON(ТелоТекст);
	Версия = Корпус.Получить("schemaVersion");
	Если ТипЗнч(Версия) <> Тип("Число") ИЛИ Версия <> 1 Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_schema_version",
			"Поддерживается только schemaVersion=1 универсального DCS-конверта.");
	КонецЕсли;
	Схема = Корпус.Получить("schema");
	Если ТипЗнч(Схема) <> Тип("Соответствие") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_schema",
			"Поле schema должно быть объектом.");
	КонецЕсли;
	ФорматСхемы = Схема.Получить("format");
	Если ФорматСхемы <> Неопределено И СокрЛП(Строка(ФорматСхемы)) <> ""
		И СокрЛП(Строка(ФорматСхемы)) <> "DataCompositionSchemaXml" Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_schema_format",
			"Поддерживается только schema.format=DataCompositionSchemaXml.");
	КонецЕсли;
	XML = Схема.Получить("xml");
	Если ТипЗнч(XML) <> Тип("Строка") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_schema",
			"Поле schema.xml должно быть строкой.");
	КонецЕсли;
	Если СокрЛП(XML) = "" Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_schema",
			"Поле schema.xml не должно быть пустым.");
	КонецЕсли;
	Параметры = ИзвлечьПараметры(Корпус);
	ИдентификаторКорреляции = ИзвлечьИдентификаторКорреляции(Корпус);
	RequestedUser = ИзвлечьRequestedUser(Корпус);
	Формат = ИзвлечьФорматВывода(Корпус);
	ReportId = Корпус.Получить("reportId");
	Если ReportId = Неопределено Тогда
		ReportId = "render";
	ИначеЕсли ТипЗнч(ReportId) <> Тип("Строка") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_request", "Поле reportId должно быть строкой.");
	Иначе
		ReportId = AIR_ReadCore.КраткоОбрезать(СокрЛП(ReportId), 80);
	КонецЕсли;
	Артефакты = ИзвлечьАртефакты(Корпус);
	Возврат Новый Структура(
		"schemaXml,parameters,correlationId,requestedUser,format,reportId,artifacts,source,Корпус",
		XML, Параметры, ИдентификаторКорреляции, RequestedUser, Формат, ReportId, Артефакты, "universal-v1", Корпус);

КонецФункции

Функция ИзвлечьАртефакты(Корпус)

	Вывод = Корпус.Получить("output");
	Если Вывод = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Если ТипЗнч(Вывод) <> Тип("Соответствие") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_request", "Поле output должно быть объектом.");
	КонецЕсли;
	Артефакты = Вывод.Получить("artifacts");
	Если Артефакты = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Если ТипЗнч(Артефакты) <> Тип("Массив") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_request", "Поле output.artifacts должно быть массивом.");
	КонецЕсли;
	Если Артефакты.Количество() > 8 Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_request", "Запрошено слишком много артефактов.");
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого Элемент Из Артефакты Цикл
		Если ТипЗнч(Элемент) <> Тип("Строка") Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_request", "Каждый элемент output.artifacts должен быть строкой.");
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЛимитыDcs(Корпус, Режим)

	Запрошенные = Новый Соответствие;
	Если Корпус <> Неопределено Тогда
		Лимиты = Корпус.Получить("limits");
		Если Лимиты <> Неопределено Тогда
			Если ТипЗнч(Лимиты) <> Тип("Соответствие") Тогда
				ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_limits", "Поле limits должно быть объектом.");
			КонецЕсли;
			ИменаЛимитов = Новый Массив;
			ИменаЛимитов.Добавить("maxRows");
			ИменаЛимитов.Добавить("maxColumns");
			ИменаЛимитов.Добавить("maxCells");
			ИменаЛимитов.Добавить("maxPreviewRows");
			ИменаЛимитов.Добавить("maxArtifactBytes");
			ИменаЛимитов.Добавить("maxResponseBytes");
			Для Каждого КЗ Из Лимиты Цикл
				Имя = Строка(КЗ.Ключ);
				Если ИменаЛимитов.Найти(Имя) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Значение = КЗ.Значение;
				Если ТипЗнч(Значение) <> Тип("Число") ИЛИ Значение <> Цел(Значение) ИЛИ Значение < 1 Тогда
					ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_limits",
						"Значение limits." + Имя + " должно быть положительным целым.");
				КонецЕсли;
				Запрошенные.Вставить(Имя, Значение);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Эффективные = Новый Структура;
	Эффективные.Вставить("maxRows", ПределDcs(Запрошенные, "maxRows", AIR_ReadCore.ТвердыйМаксимум("maxRows")));
	Эффективные.Вставить("maxColumns", ПределDcs(Запрошенные, "maxColumns", AIR_ReadCore.ТвердыйМаксимум("maxColumns")));
	Эффективные.Вставить("maxCells", ПределDcs(Запрошенные, "maxCells", AIR_ReadCore.ТвердыйМаксимум("maxCells")));
	Эффективные.Вставить("maxPreviewRows", ПределDcs(Запрошенные, "maxPreviewRows", AIR_ReadCore.ТвердыйМаксимум("maxPreviewRows")));
	Эффективные.Вставить("maxArtifactBytes", ПределDcs(Запрошенные, "maxArtifactBytes", AIR_ReadCore.ТвердыйМаксимум("maxArtifactBytes")));
	ДефолтОтвета = ?(Режим = "render", 6291456, 4194304);
	Эффективные.Вставить("maxResponseBytes", ПределDcs(Запрошенные, "maxResponseBytes", ДефолтОтвета, "maxDcsResponseBytes"));
	Эффективные.Вставить("requested", Запрошенные);
	Эффективные.Вставить("hardCaps", AIR_ReadCore.ТвердыеМаксимумы());
	Эффективные.Вставить("scope", "per_request_response_shape");
	Эффективные.Вставить("serverEnforced", Истина);
	Эффективные.Вставить("executionTimeoutSupported", Ложь);
	Эффективные.Вставить("timeoutCancelsServerExecution", Ложь);
	Эффективные.Вставить("fullResultMaterializedBeforeOutputShaping", Истина);
	Эффективные.Вставить("note", "Конечные ограничения формы ответа; полный результат СКД/materialization может быть больше выданной части.");
	Возврат Эффективные;

КонецФункции

Функция ПределDcs(Запрошенные, Имя, ЗначениеПоУмолчанию, ИмяМаксимума = "")

	Максимум = AIR_ReadCore.ТвердыйМаксимум(?(ИмяМаксимума = "", Имя, ИмяМаксимума));
	Значение = Запрошенные.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат Мин(ЗначениеПоУмолчанию, Максимум);
	КонецЕсли;
	Возврат Мин(Значение, Максимум);

КонецФункции

Функция СформироватьСводкуСхемы(Проверка)

	ИмяНабора = "";
	Если Проверка.Сведения.datasets.Количество() > 0 Тогда
		ИмяНабора = Проверка.Сведения.datasets.Получить(0).name;
	КонецЕсли;
	ИмяИсточника = "";
	Если Проверка.Сведения.sources.Количество() > 0 Тогда
		ИмяИсточника = Проверка.Сведения.sources.Получить(0).name;
	КонецЕсли;
	Возврат Новый Структура(
		"datasetName,sourceName,queryTextSha256,queryTextLength,parameterNames,settings",
		ИмяНабора, ИмяИсточника, Проверка.Сведения.queryTextSha256,
		СтрДлина(Проверка.Сведения.queryText), Проверка.Сведения.parameterNames,
		Проверка.Сведения.settings);

КонецФункции

Функция СформироватьДопускDcs(Сведения)

	Допуск = Новый Структура;
	Допуск.Вставить("status", "admitted");
	Допуск.Вставить("mode", "dcs");
	Допуск.Вставить("externalFunctions", Ложь);
	Допуск.Вставить("referenceFieldsByViewRight", Истина);
	Допуск.Вставить("queryParts", Новый Массив);
	Допуск.Вставить("datasetCount", Сведения.datasetCount);
	Допуск.Вставить("linkCount", Сведения.linkCount);
	Допуск.Вставить("sources", Сведения.sources);
	Для Каждого Части Из Сведения.queryParts Цикл
		Допуск.queryParts.Добавить(Новый Структура(
			"path,textPreview,textLength,canonicalTextLength,canonicalTextSha256,operators,packetElements,allowedSelectVerified,lockRejected,datasetFilterLength",
			Части.path, AIR_ReadCore.КраткоОбрезать(Части.queryText, 240), Части.queryLength,
			Части.canonicalTextLength, Части.queryTextSha256, Части.operators,
			Части.packetElements, Части.allowedSelectVerified, Части.lockRejected,
			Части.datasetFilterLength));
	КонецЦикла;
	Возврат Допуск;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Ответы и JSON

Функция ВерсияСервиса()

	Возврат "0.2.0";

КонецФункции

Функция НоваяКонечнаяТочка(Метод, Путь, Назначение)

	Возврат Новый Структура("method,path,purpose", Метод, Путь, Назначение);

КонецФункции

Функция ОтветJSON(КодСостояния, Данные)

	Возврат ОтветJSONИзТекста(КодСостояния, AIR_ReadCore.ТекстJSON(Данные));

КонецФункции

Функция ОтветJSONИзТекста(КодСостояния, Текст)

	Возврат ОтветСТекстом(КодСостояния, Текст, "application/json; charset=utf-8");

КонецФункции

Функция ОтветСТекстом(КодСостояния, Текст, ТипСодержимого)

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", ТипСодержимого);
	Ответ.Заголовки.Вставить("Cache-Control", "no-store");
	Ответ.УстановитьТелоИзСтроки(Текст, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;

КонецФункции

Функция ОтветИзИсключения(Информация, ИдентификаторКорреляции = "")

	Описание = "";
	Попытка
		Описание = Информация.Описание;
	Исключение
		Описание = "";
	КонецПопытки;
	КодОшибки = "internal_error";
	ТекстОшибки = "Внутренняя ошибка сервиса.";
	Диагностика = "";
	Префикс = "AIR|";
	Если СтрДлина(Описание) >= СтрДлина(Префикс) И Лев(Описание, СтрДлина(Префикс)) = Префикс Тогда
		Остаток = Сред(Описание, СтрДлина(Префикс) + 1);
		Разделитель = СтрНайти(Остаток, "|");
		Если Разделитель = 0 Тогда
			КодОшибки = Остаток;
			ТекстОшибки = "Ошибка запроса.";
		Иначе
			КодОшибки = Лев(Остаток, Разделитель - 1);
			ТекстОшибки = Сред(Остаток, Разделитель + 1);
		КонецЕсли;
	Иначе
		Диагностика = AIR_ReadCore.КраткоОбрезать(Описание, 400);
	КонецЕсли;
	Данные = Новый Структура;
	Данные.Вставить("success", Ложь);
	Данные.Вставить("service", "ai-data-read");
	Данные.Вставить("code", КодОшибки);
	Данные.Вставить("message", ТекстОшибки);
	Детали = Новый Структура;
	Если Диагностика <> "" Тогда
		Детали.Вставить("diagnostic", Диагностика);
	КонецЕсли;
	Детали.Вставить("errorClass", ?(КодОшибки = "internal_error", "internal", "request"));
	Данные.Вставить("details", Детали);
	ВставитьКорреляцию(Данные, ИдентификаторКорреляции);
	Возврат ОтветJSON(КодHTTPПоОшибке(КодОшибки), Данные);

КонецФункции

Функция КодHTTPПоОшибке(КодОшибки)

	Если КодОшибки = "internal_error"
		ИЛИ КодОшибки = "temp_manager_close_error"
		ИЛИ КодОшибки = "dcs_execution_error"
		ИЛИ КодОшибки = "dcs_render_error" Тогда
		Возврат 500;
	КонецЕсли;
	Если КодОшибки = "request_too_large"
		ИЛИ КодОшибки = "query_text_too_long"
		ИЛИ КодОшибки = "too_many_parameters"
		ИЛИ КодОшибки = "schema_too_large"
		ИЛИ КодОшибки = "response_limit_exceeded"
		ИЛИ КодОшибки = "artifact_too_large" Тогда
		Возврат 413;
	КонецЕсли;
	Возврат 400;

КонецФункции







////////////////////////////////////////////////////////////////////////////////
// Чтение и валидация запроса

Функция ПрочитатьТелоЗапроса(Запрос)

	ТелоТекст = ПрочитатьТелоЗапросаКакТекст(Запрос, "maxRequestBytes");
	Возврат РазобратьТелоЗапросаJSON(ТелоТекст);

КонецФункции

Функция ПрочитатьТелоЗапросаКакТекст(Запрос, ИмяЛимита = "maxRequestBytes")

	Двоичные = Запрос.ПолучитьТелоКакДвоичныеДанные();
	Если Двоичные = Неопределено Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_request", "Тело запроса отсутствует.");
	КонецЕсли;
	Если Двоичные.Размер() > AIR_ReadCore.ТвердыйМаксимум(ИмяЛимита) Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("request_too_large", "Тело запроса превышает допустимый размер.");
	КонецЕсли;
	ТелоТекст = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если ТипЗнч(ТелоТекст) <> Тип("Строка") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_request", "Тело запроса не является строкой UTF-8.");
	КонецЕсли;
	Если СокрЛП(ТелоТекст) = "" Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_request", "Тело запроса пустое.");
	КонецЕсли;
	Возврат ТелоТекст;

КонецФункции

Функция РазобратьТелоЗапросаJSON(ТелоТекст)

	ТелоТекст = СтрЗаменить(ТелоТекст, Символ(65279), "");
	Чтение = Новый ЧтениеJSON;
	Попытка
		Чтение.УстановитьСтроку(ТелоТекст);
		Данные = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_json", "Тело запроса не является корректным JSON.");
	КонецПопытки;
	Чтение.Закрыть();
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_request", "Корень JSON-тела должен быть объектом.");
	КонецЕсли;
	Возврат Данные;

КонецФункции

Функция ИзвлечьТекстЗапроса(Корпус)

	Запрос = Корпус.Получить("query");
	Если ТипЗнч(Запрос) <> Тип("Соответствие") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_request", "Поле query должно быть объектом.");
	КонецЕсли;
	Язык = Запрос.Получить("language");
	Если Язык <> Неопределено И СокрЛП(Строка(Язык)) <> "1c" Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_language", "Поддерживается только язык запросов 1c.");
	КонецЕсли;
	Текст = Запрос.Получить("text");
	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_request", "Поле query.text должно быть строкой.");
	КонецЕсли;
	Если СокрЛП(Текст) = "" Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_request", "Поле query.text не должно быть пустым.");
	КонецЕсли;
	Если СтрДлина(Текст) > AIR_ReadCore.ТвердыйМаксимум("maxQueryTextLength") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("query_text_too_long", "Текст запроса превышает допустимую длину.");
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция ИзвлечьЗапрошенныйХеш(Корпус)

	Запрос = Корпус.Получить("query");
	Если ТипЗнч(Запрос) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Хеш = Запрос.Получить("hash");
	Если ТипЗнч(Хеш) = Тип("Строка") Тогда
		Возврат AIR_ReadCore.КраткоОбрезать(Хеш, 128);
	КонецЕсли;
	Возврат "";

КонецФункции

