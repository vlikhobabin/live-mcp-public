////////////////////////////////////////////////////////////////////////////////
// Модуль AIR_DcsExecution расширения AIDataRead.
//
// Назначение: безопасный read-only путь СКД для AIDataRead:
//   XML/XDTO -> проверка поддержанного schema/settings graph -> настройки и
//   типизированные параметры ДО compile -> collection/tabdoc layout ->
//   полный допуск фактически исполняемых query texts -> Initialize
//   (внешние функции Ложь, ограничение ссылочных полей по праву Просмотр).
//
// Начальный поддержанный subset: один локальный query dataset, типизированные
// параметры, выбранные поля, обычная группировка, штатные SUM/COUNT, сортировка.
// Schema-level простые отборы допускаются только при известных безопасных
// значениях; скомпонованный dataset .Отбор до отдельной квалификации явно
// отклоняется. Object/union/nested datasets, связи наборов, вычисляемые поля,
// parameter/field/total expressions вне узкого whitelist, пользовательские поля,
// условное оформление и custom templates отклоняются.
//
// Инварианты:
//   * после полного допуска никаких новых settings/compile transforms; в
//     скомпонованный набор назначается именно допущенный canonical text,
//     setter и readback выполняются до Initialize;
//   * исполняется только макет, все query-bearing части которого перечислены и
//     допущены через общий AIR_ReadCore;
//   * Initialize выполняется только после допуска и успешного setter/readback;
//   * модуль серверный, неглобальный, непривилегированный, без ServerCall.
////////////////////////////////////////////////////////////////////////////////

Функция ПрочитатьСхемуИзXML(ТекстXML) Экспорт

	ОчищенныйТекст = ОчиститьТекстXML(ТекстXML);
	РазмерБайт = ПолучитьДвоичныеДанныеИзСтроки(ОчищенныйТекст, КодировкаТекста.UTF8).Размер();
	Если РазмерБайт > AIR_ReadCore.ТвердыйМаксимум("maxDcsSchemaBytes") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("schema_too_large",
			"Размер XML-схемы СКД в UTF-8 байтах превышает допустимый.");
	КонецЕсли;
	ПроверитьОтсутствиеDTD(ОчищенныйТекст);

	Чтение = Новый ЧтениеXML;
	Попытка
		Чтение.УстановитьСтроку(ОчищенныйТекст);
		Схема = СериализаторXDTO.ПрочитатьXML(Чтение, Тип("СхемаКомпоновкиДанных"));
	Исключение
		Попытка
			Чтение.Закрыть();
		Исключение
			// Закрытие не заменяет первичную ошибку разбора.
		КонецПопытки;
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_schema_xml",
			"XML не является корректной схемой компоновки данных.");
	КонецПопытки;
	Попытка
		Чтение.Закрыть();
	Исключение
		// Освобождение чтения не влияет на уже прочитанную схему.
	КонецПопытки;

	Если ТипЗнч(Схема) <> Тип("СхемаКомпоновкиДанных") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_schema_xml",
			"Переданный XML не является схемой компоновки данных.");
	КонецЕсли;
	Возврат Схема;

КонецФункции

Функция ПрочитатьИПроверитьСхему(ТекстXML) Экспорт

	Схема = ПрочитатьСхемуИзXML(ТекстXML);
	Сведения = ПроверитьСхемуИНастройки(Схема);
	Возврат Новый Структура("Схема,Сведения", Схема, Сведения);

КонецФункции

Функция ПроверитьСхемуИНастройки(Схема) Экспорт

	Сведения = Новый Структура;
	Сведения.Вставить("sources", Новый Массив);
	Сведения.Вставить("datasets", Новый Массив);
	Сведения.Вставить("queryText", "");
	Сведения.Вставить("queryTextSha256", "");
	Сведения.Вставить("queryAdmission", Неопределено);
	Сведения.Вставить("parameterNames", Новый Массив);
	Сведения.Вставить("settings", Новый Структура);

	Источники = Схема.ИсточникиДанных;
	Если ТипЗнч(Источники) <> Тип("ИсточникиДанныхСхемыКомпоновкиДанных") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_schema_graph",
			"Схема не содержит коллекции источников данных.");
	КонецЕсли;
	Если Источники.Количество() <> 1 Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_data_source",
			"Поддерживается ровно один локальный источник данных.");
	КонецЕсли;
	Источник = Источники.Получить(0);
	ИмяИсточника = СокрЛП(Строка(Источник.Имя));
	ТипИсточника = СокрЛП(Строка(Источник.ТипИсточникаДанных));
	СтрокаСоединения = СокрЛП(Строка(Источник.СтрокаСоединения));
	Если ИмяИсточника = "" Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_data_source",
			"Источник данных должен иметь непустое имя.");
	КонецЕсли;
	Если ТипИсточника <> "Local" ИЛИ СтрокаСоединения <> "" Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_data_source",
			"Поддерживается только локальный источник текущей информационной базы.");
	КонецЕсли;
	Сведения.sources.Добавить(Новый Структура("name,type,connectionString",
		ИмяИсточника, ТипИсточника, СтрокаСоединения));

	Если Схема.СвязиНаборовДанных.Количество() <> 0 Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_dataset_links",
			"Связи наборов данных не поддерживаются в начальном subset СКД.");
	КонецЕсли;
	Если Схема.ВычисляемыеПоля.Количество() <> 0 Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_calculated_fields",
			"Вычисляемые поля схемы СКД не поддерживаются в начальном subset.");
	КонецЕсли;
	Если Схема.ВложенныеСхемыКомпоновкиДанных.Количество() <> 0 Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_nested_schema",
			"Вложенные схемы компоновки данных не поддерживаются.");
	КонецЕсли;
	Если Схема.Макеты.Количество() <> 0
		ИЛИ Схема.МакетыГруппировок.Количество() <> 0
		ИЛИ Схема.МакетыЗаголовковГруппировок.Количество() <> 0
		ИЛИ Схема.МакетыПолей.Количество() <> 0
		ИЛИ Схема.МакетыПолейИтога.Количество() <> 0 Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_custom_templates",
			"Custom templates схемы СКД не поддерживаются в начальном subset.");
	КонецЕсли;
	Если Схема.ВариантыНастроек.Количество() <> 1 Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_settings_variant",
			"Поддерживается ровно один вариант настроек СКД.");
	КонецЕсли;

	Наборы = Схема.НаборыДанных;
	Если ТипЗнч(Наборы) <> Тип("НаборыДанныхСхемыКомпоновкиДанных") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_schema_graph",
			"Схема не содержит коллекции наборов данных.");
	КонецЕсли;
	Если Наборы.Количество() <> 1 Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_multiple_datasets",
			"Начальный subset СКД поддерживает ровно один набор данных.");
	КонецЕсли;
	Набор = Наборы.Получить(0);
	Если ТипЗнч(Набор) <> Тип("НаборДанныхЗапросСхемыКомпоновкиДанных") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_dataset_type",
			"Поддерживается только query dataset локального источника.");
	КонецЕсли;
	Если СокрЛП(Строка(Набор.ИсточникДанных)) <> ИмяИсточника Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_dataset_source",
			"Query dataset должен ссылаться на единственный локальный источник данных.");
	КонецЕсли;
	ТекстЗапроса = СокрЛП(Строка(Набор.Запрос));
	Если ТекстЗапроса = "" Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_query_dataset",
			"Query dataset содержит пустой текст запроса.");
	КонецЕсли;
	Если СтрДлина(ТекстЗапроса) > AIR_ReadCore.ТвердыйМаксимум("maxQueryTextLength") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("query_text_too_long",
			"Текст исходного запроса СКД превышает допустимую длину.");
	КонецЕсли;
	Попытка
		ДопускИсходногоЗапроса = AIR_ReadCore.ПроверитьИПодготовитьЗапрос(ТекстЗапроса);
	Исключение
		Описание = AIR_ReadCore.ТекстОписанияОшибки(ИнформацияОбОшибке());
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_query_dataset",
			"Исходный запрос СКД не прошёл read-only допуск: " + AIR_ReadCore.КраткоОбрезать(Описание, 400));
	КонецПопытки;
	Сведения.queryText = ТекстЗапроса;
	Сведения.queryTextSha256 = ДопускИсходногоЗапроса.КаноническийХешSHA256;
	Сведения.queryAdmission = ДопускИсходногоЗапроса;
	Сведения.datasets.Добавить(Новый Структура("name,type,source,queryLength",
		СокрЛП(Строка(Набор.Имя)), "query", ИмяИсточника, СтрДлина(ТекстЗапроса)));

	ДопустимыеПоля = Новый Соответствие;
	ПоляНабора = Набор.Поля;
	Если ТипЗнч(ПоляНабора) <> Тип("ПоляНабораДанныхСхемыКомпоновкиДанных") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_dataset_fields",
			"Query dataset не содержит коллекции полей схемы.");
	КонецЕсли;
	Если ПоляНабора.Количество() = 0 Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_dataset_fields",
			"Query dataset должен содержать явные описания полей.");
	КонецЕсли;
	Для Индекс = 0 По ПоляНабора.Количество() - 1 Цикл
		ПолеНабора = ПоляНабора.Получить(Индекс);
		Если ТипЗнч(ПолеНабора) <> Тип("ПолеНабораДанныхСхемыКомпоновкиДанных") Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_dataset_fields",
				"Папки и неизвестные элементы полей query dataset не поддерживаются.");
		КонецЕсли;
		ПутьПоля = СокрЛП(Строка(ПолеНабора.ПутьКДанным));
		ИмяПоля = СокрЛП(Строка(ПолеНабора.Поле));
		Если ПутьПоля <> "" Тогда
			ДобавитьДопустимоеПоле(ДопустимыеПоля, ПутьПоля);
		КонецЕсли;
		Если ИмяПоля <> "" Тогда
			ДобавитьДопустимоеПоле(ДопустимыеПоля, ИмяПоля);
		КонецЕсли;
		Если ПутьПоля = "" И ИмяПоля = "" Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_dataset_fields",
				"Поле query dataset не имеет пути к данным.");
		КонецЕсли;
		ВыражениеПредставления = "";
		Попытка
			ЗначениеВыражения = ПолеНабора.ВыражениеПредставления;
			Если ЗначениеВыражения <> Неопределено Тогда
				ВыражениеПредставления = СокрЛП(Строка(ЗначениеВыражения));
			КонецЕсли;
		Исключение
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_schema_graph",
				"Не удалось проверить expression surface поля query dataset.");
		КонецПопытки;
		Если ВыражениеПредставления <> "" Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_field_expression",
				"Выражение представления поля query dataset не поддерживается.");
		КонецЕсли;
		Попытка
			ВыраженияУпорядочивания = ПолеНабора.ВыраженияУпорядочивания;
		Исключение
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_schema_graph",
				"Не удалось прочитать выражения упорядочивания поля query dataset.");
		КонецПопытки;
		Если ВыраженияУпорядочивания <> Неопределено Тогда
			Попытка
				КоличествоВыраженийУпорядочивания = ВыраженияУпорядочивания.Количество();
			Исключение
				ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_schema_graph",
					"Не удалось проверить коллекцию выражений упорядочивания поля query dataset.");
			КонецПопытки;
			Если КоличествоВыраженийУпорядочивания <> 0 Тогда
				ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_field_order_expression",
					"Выражения упорядочивания поля query dataset не поддерживаются.");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Параметры = Схема.Параметры;
	Если ТипЗнч(Параметры) <> Тип("ПараметрыСхемыКомпоновкиДанных") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_schema_graph",
			"Схема не содержит коллекции параметров.");
	КонецЕсли;
	ДопустимыеПараметры = Новый Соответствие;
	Для Индекс = 0 По Параметры.Количество() - 1 Цикл
		Параметр = Параметры.Получить(Индекс);
		ИмяПараметра = СокрЛП(Строка(Параметр.Имя));
		Если ИмяПараметра = "" Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_schema_graph",
				"Параметр схемы СКД имеет пустое имя.");
		КонецЕсли;
		ДопустимыеПараметры.Вставить(ВРег(ИмяПараметра), Истина);
		Сведения.parameterNames.Добавить(ИмяПараметра);
		ВыражениеПараметра = "";
		Попытка
			ЗначениеВыражения = Параметр.Выражение;
			Если ЗначениеВыражения <> Неопределено Тогда
				ВыражениеПараметра = СокрЛП(Строка(ЗначениеВыражения));
			КонецЕсли;
		Исключение
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_schema_graph",
				"Не удалось проверить выражение параметра СКД.");
		КонецПопытки;
		Если ВыражениеПараметра <> "" Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_parameter_expression",
				"Выражения параметров схемы СКД запрещены в начальном subset.");
		КонецЕсли;
	КонецЦикла;

	ПроверитьПоляИтога(Схема.ПоляИтога, ДопустимыеПоля);

	Настройки = Схема.НастройкиПоУмолчанию;
	Если Настройки = Неопределено Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_settings_variant",
			"Схема не содержит настроек по умолчанию.");
	КонецЕсли;
	Сведения.settings = ПроверитьНастройки(Настройки, ДопустимыеПоля, ДопустимыеПараметры);
	Возврат Сведения;

КонецФункции

Функция ПроверитьНастройки(Настройки, ДопустимыеПоля, ДопустимыеПараметры) Экспорт

	Сведения = Новый Структура;
	Сведения.Вставить("structureItems", Новый Массив);
	Сведения.Вставить("filterItems", 0);
	Сведения.Вставить("orderItems", 0);
	Сведения.Вставить("selectionItems", 0);
	Сведения.Вставить("dataParameterItems", 0);

	Если Настройки.ПользовательскиеПоля.Элементы.Количество() <> 0 Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_user_fields",
			"Пользовательские поля настроек СКД не поддерживаются.");
	КонецЕсли;
	Если Настройки.УсловноеОформление.Элементы.Количество() <> 0 Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_conditional_appearance",
			"Условное оформление СКД не поддерживается в начальном subset.");
	КонецЕсли;

	ПроверитьВыбор(Настройки.Выбор, ДопустимыеПоля);
	Сведения.selectionItems = Настройки.Выбор.Элементы.Количество();
	ПроверитьПараметрыДанных(Настройки.ПараметрыДанных, ДопустимыеПараметры);
	Сведения.dataParameterItems = Настройки.ПараметрыДанных.Элементы.Количество();
	ПроверитьОтбор(Настройки.Отбор, ДопустимыеПоля, ДопустимыеПараметры);
	Сведения.filterItems = Настройки.Отбор.Элементы.Количество();
	ПроверитьПорядок(Настройки.Порядок, ДопустимыеПоля);
	Сведения.orderItems = Настройки.Порядок.Элементы.Количество();
	ПроверитьЭлементыСтруктуры(Настройки.Структура, 0, Сведения.structureItems, ДопустимыеПоля, ДопустимыеПараметры);
	Возврат Сведения;

КонецФункции

Процедура ПроверитьЭлементыСтруктуры(Элементы, Глубина, Сведения, ДопустимыеПоля, ДопустимыеПараметры)

	Если Глубина > 8 Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_settings_structure",
			"Превышена глубина структуры настроек СКД.");
	КонецЕсли;
	Для Индекс = 0 По Элементы.Количество() - 1 Цикл
		Элемент = Элементы.Получить(Индекс);
		Если ТипЗнч(Элемент) = Тип("ГруппировкаКомпоновкиДанных") Тогда
			Сведения.Добавить(Новый Структура("type,name,depth", "group", СокрЛП(Строка(Элемент.Имя)), Глубина));
			ПроверитьВыбор(Элемент.Выбор, ДопустимыеПоля);
			ПроверитьПоляГруппировки(Элемент.ПоляГруппировки, ДопустимыеПоля);
			ПроверитьОтбор(Элемент.Отбор, ДопустимыеПоля, ДопустимыеПараметры);
			ПроверитьПорядок(Элемент.Порядок, ДопустимыеПоля);
			Если Элемент.УсловноеОформление.Элементы.Количество() <> 0 Тогда
				ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_conditional_appearance",
					"Условное оформление группировки СКД не поддерживается.");
			КонецЕсли;
			ПроверитьЭлементыСтруктуры(Элемент.Структура, Глубина + 1, Сведения, ДопустимыеПоля, ДопустимыеПараметры);
		ИначеЕсли ТипЗнч(Элемент) = Тип("ТаблицаКомпоновкиДанных") Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_settings_structure",
				"Табличная структура настроек СКД не поддерживается в начальном subset.");
		Иначе
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_settings_structure",
				"Неподдерживаемый элемент структуры настроек СКД: " + Строка(ТипЗнч(Элемент)));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьВыбор(Выбор, ДопустимыеПоля)

	Если Выбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Индекс = 0 По Выбор.Элементы.Количество() - 1 Цикл
		Элемент = Выбор.Элементы.Получить(Индекс);
		Если ТипЗнч(Элемент) = Тип("ВыбранноеПолеКомпоновкиДанных") Тогда
			Если Не ЭтоДопустимоеПоле(ДопустимыеПоля, Элемент.Поле) Тогда
				ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_selection_field",
					"Выбранное поле не входит в допущенные поля query dataset.");
			КонецЕсли;
		ИначеЕсли ТипЗнч(Элемент) = Тип("АвтоВыбранноеПолеКомпоновкиДанных") Тогда
			Продолжить;
		Иначе
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_selection_field",
				"Неподдерживаемый элемент выбора настроек СКД: " + Строка(ТипЗнч(Элемент)));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПоляГруппировки(ПоляГруппировки, ДопустимыеПоля)

	Если ПоляГруппировки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Индекс = 0 По ПоляГруппировки.Элементы.Количество() - 1 Цикл
		Элемент = ПоляГруппировки.Элементы.Получить(Индекс);
		Если ТипЗнч(Элемент) <> Тип("ПолеГруппировкиКомпоновкиДанных") Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_group_field",
				"Неподдерживаемое поле группировки СКД.");
		КонецЕсли;
		Если Не ЭтоДопустимоеПростоеПоле(ДопустимыеПоля, Элемент.Поле) Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_group_field",
				"Поле группировки не входит в допущенные поля query dataset.");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПараметрыДанных(ПараметрыДанных, ДопустимыеПараметры)

	Если ПараметрыДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Индекс = 0 По ПараметрыДанных.Элементы.Количество() - 1 Цикл
		Элемент = ПараметрыДанных.Элементы.Получить(Индекс);
		Если ТипЗнч(Элемент) <> Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_settings_value",
				"Неподдерживаемый элемент параметров данных СКД.");
		КонецЕсли;
		ИмяПараметра = ТекстПараметра(Элемент.Параметр);
		Если ИмяПараметра = "" ИЛИ ДопустимыеПараметры.Получить(ВРег(ИмяПараметра)) = Неопределено Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_settings_value",
				"Параметр настроек СКД отсутствует в схеме.");
		КонецЕсли;
		Если Не ЭтоБезопасноеЗначение(Элемент.Значение, ДопустимыеПараметры) Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_settings_value",
				"Значение параметра данных СКД не входит в безопасный subset.");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОтбор(Отбор, ДопустимыеПоля, ДопустимыеПараметры)

	Если Отбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Индекс = 0 По Отбор.Элементы.Количество() - 1 Цикл
		Элемент = Отбор.Элементы.Получить(Индекс);
		Если ТипЗнч(Элемент) <> Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_filter",
				"Неподдерживаемый элемент отбора СКД.");
		КонецЕсли;
		ВидСравненияОтбора = Элемент.ВидСравнения;
		Если ВидСравненияОтбора <> ВидСравненияКомпоновкиДанных.Равно
			И ВидСравненияОтбора <> ВидСравненияКомпоновкиДанных.НеРавно
			И ВидСравненияОтбора <> ВидСравненияКомпоновкиДанных.Больше
			И ВидСравненияОтбора <> ВидСравненияКомпоновкиДанных.БольшеИлиРавно
			И ВидСравненияОтбора <> ВидСравненияКомпоновкиДанных.Меньше
			И ВидСравненияОтбора <> ВидСравненияКомпоновкиДанных.МеньшеИлиРавно
			И ВидСравненияОтбора <> ВидСравненияКомпоновкиДанных.ВСписке Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_filter",
				"Вид сравнения отбора СКД не поддерживается в начальном subset.");
		КонецЕсли;
		Если ТипЗнч(Элемент.ЛевоеЗначение) <> Тип("ПолеКомпоновкиДанных")
			ИЛИ Не ЭтоДопустимоеПростоеПоле(ДопустимыеПоля, Элемент.ЛевоеЗначение) Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_filter",
				"Левое значение отбора СКД должно быть допущенным полем query dataset.");
		КонецЕсли;
		ПравоеЗначение = Элемент.ПравоеЗначение;
		ТипПравого = ТипЗнч(ПравоеЗначение);
		Если ТипПравого = Тип("ПолеКомпоновкиДанных") Тогда
			Если Не ЭтоДопустимоеПростоеПоле(ДопустимыеПоля, ПравоеЗначение) Тогда
				ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_filter",
					"Правое поле отбора СКД не входит в допущенные поля query dataset.");
			КонецЕсли;
		ИначеЕсли ТипПравого = Тип("ПараметрКомпоновкиДанных") Тогда
			ИмяПараметра = ТекстПараметра(ПравоеЗначение);
			Если ИмяПараметра = "" ИЛИ ДопустимыеПараметры.Получить(ВРег(ИмяПараметра)) = Неопределено Тогда
				ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_filter",
					"Параметр отбора СКД отсутствует в схеме.");
			КонецЕсли;
		ИначеЕсли Не ЭтоБезопасноеЗначение(ПравоеЗначение, ДопустимыеПараметры) Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_filter",
				"Правое значение отбора СКД не входит в безопасный subset.");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПорядок(Порядок, ДопустимыеПоля)

	Если Порядок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Индекс = 0 По Порядок.Элементы.Количество() - 1 Цикл
		Элемент = Порядок.Элементы.Получить(Индекс);
		Если ТипЗнч(Элемент) = Тип("АвтоЭлементПорядкаКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Элемент) <> Тип("ЭлементПорядкаКомпоновкиДанных") Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_order",
				"Неподдерживаемый элемент порядка СКД.");
		КонецЕсли;
		Если Не ЭтоДопустимоеПоле(ДопустимыеПоля, Элемент.Поле) Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_order",
				"Поле порядка СКД не входит в допущенные поля query dataset.");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПоляИтога(ПоляИтога, ДопустимыеПоля)

	Если ПоляИтога = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Индекс = 0 По ПоляИтога.Количество() - 1 Цикл
		ПолеИтога = ПоляИтога.Получить(Индекс);
		Путь = СокрЛП(Строка(ПолеИтога.ПутьКДанным));
		Если Путь = "" ИЛИ ДопустимыеПоля.Получить(ВРег(Путь)) = Неопределено Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_total_field",
				"Поле итога не входит в допущенные поля query dataset.");
		КонецЕсли;
		Выражение = "";
		Попытка
			ЗначениеВыражения = ПолеИтога.Выражение;
			Если ЗначениеВыражения <> Неопределено Тогда
				Выражение = СокрЛП(Строка(ЗначениеВыражения));
			КонецЕсли;
		Исключение
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_total_field",
				"Не удалось прочитать выражение поля итога.");
		КонецПопытки;
		Если Выражение = "" ИЛИ Не ЭтоРазрешенноеВыражениеИтога(Выражение, ДопустимыеПоля) Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_total_expression",
				"Выражение итога допускает только SUM/COUNT по допущенным полям.");
		КонецЕсли;
		Группировки = ПолеИтога.Группировки;
		Если Группировки <> Неопределено Тогда
			Для Каждого ИмяГруппировки Из Группировки Цикл
				Имя = СокрЛП(Строка(ИмяГруппировки));
				Если Имя = "" ИЛИ ДопустимыеПоля.Получить(ВРег(Имя)) = Неопределено Тогда
					ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_total_group",
						"Группировка итога не входит в допущенные поля query dataset.");
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ТекстПоля(Поле)

	Если Поле = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Текст = СокрЛП(Строка(Поле.Имя));
		Если Текст <> "" Тогда
			Возврат Текст;
		КонецЕсли;
	Исключение
		// Ниже используется строковое представление поля.
	КонецПопытки;
	Попытка
		Возврат СокрЛП(Строка(Поле));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция ТекстПараметра(Параметр)

	Если Параметр = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Текст = СокрЛП(Строка(Параметр.Имя));
		Если Текст <> "" Тогда
			Возврат Текст;
		КонецЕсли;
	Исключение
		// Ниже используется строковое представление параметра.
	КонецПопытки;
	Попытка
		Возврат СокрЛП(Строка(Параметр));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Процедура ДобавитьДопустимоеПоле(ДопустимыеПоля, Имя)

	НормализованноеИмя = СокрЛП(Строка(Имя));
	Если НормализованноеИмя <> "" Тогда
		ДопустимыеПоля.Вставить(ВРег(НормализованноеИмя), Истина);
	КонецЕсли;

КонецПроцедуры

Функция ЭтоДопустимоеПростоеПоле(ДопустимыеПоля, Поле)

	Текст = ТекстПоля(Поле);
	Если Текст = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ДопустимыеПоля.Получить(ВРег(Текст)) <> Неопределено;

КонецФункции

Функция ЭтоДопустимоеПоле(ДопустимыеПоля, Поле)

	Текст = ТекстПоля(Поле);
	Если Текст = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ДопустимыеПоля.Получить(ВРег(Текст)) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ЭтоРазрешенноеВыражениеИтога(Текст, ДопустимыеПоля);

КонецФункции

Функция ЭтоРазрешенноеВыражениеИтога(Выражение, ДопустимыеПоля)

	Верх = ВРег(СокрЛП(Строка(Выражение)));
	Если ПроверитьАгрегатПоФункции(Верх, "СУММА", ДопустимыеПоля) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ПроверитьАгрегатПоФункции(Верх, "КОЛИЧЕСТВО", ДопустимыеПоля);

КонецФункции

Функция ПроверитьАгрегатПоФункции(Верх, ИмяФункции, ДопустимыеПоля)

	Префикс = ИмяФункции + "(";
	Если Верх = ИмяФункции + "()" Тогда
		Возврат ИмяФункции = "КОЛИЧЕСТВО";
	КонецЕсли;
	Если Лев(Верх, СтрДлина(Префикс)) <> Префикс ИЛИ Прав(Верх, 1) <> ")" Тогда
		Возврат Ложь;
	КонецЕсли;
	Внутренность = СокрЛП(Сред(Верх, СтрДлина(Префикс) + 1, СтрДлина(Верх) - СтрДлина(Префикс) - 1));
	Если Внутренность = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрНайти(Внутренность, "(") > 0 ИЛИ СтрНайти(Внутренность, ")") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ЭтоДопустимоеИмяПоля(Внутренность) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ДопустимыеПоля.Получить(ВРег(Внутренность)) <> Неопределено;

КонецФункции

Функция ЭтоДопустимоеИмяПоля(Имя)

	Если СтрДлина(Имя) < 1 ИЛИ СтрДлина(Имя) > 128 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Имя) Цикл
		Код = КодСимвола(Имя, Позиция);
		ЭтоБуква = (Код >= 65 И Код <= 90) ИЛИ (Код >= 97 И Код <= 122)
			ИЛИ (Код >= 1040 И Код <= 1103) ИЛИ Код = 1025 ИЛИ Код = 1105;
		ЭтоЦифра = (Код >= 48 И Код <= 57);
		Если НЕ ЭтоБуква И НЕ ЭтоЦифра И Код <> 95 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ЭтоБезопасноеЗначение(Значение, ДопустимыеПараметры)

	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат Истина;
	КонецЕсли;
	Если ЭтоБезопасноеСкалярноеЗначение(Значение) Тогда
		Возврат Истина;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если Не ЭтоБезопасноеСкалярноеЗначение(Элемент) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		Возврат Истина;
	КонецЕсли;
	Если ТипЗначения = Тип("ПараметрКомпоновкиДанных") Тогда
		Имя = ТекстПараметра(Значение);
		Возврат Имя <> "" И ДопустимыеПараметры.Получить(ВРег(Имя)) <> Неопределено;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Функция ЭтоБезопасноеСкалярноеЗначение(Значение)

	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат Истина;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка")
		ИЛИ ТипЗначения = Тип("Число")
		ИЛИ ТипЗначения = Тип("Булево")
		ИЛИ ТипЗначения = Тип("Дата")
		ИЛИ ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат AIR_ReadCore.ЭтоСсылка(Значение);

КонецФункции

Функция СоздатьКомпоновщикНастроек(Схема) Экспорт

	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	Возврат Компоновщик;

КонецФункции

Процедура ПрименитьПараметры(Компоновщик, Параметры, ИменаПараметровСхемы) Экспорт

	Если ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_parameter",
			"Параметры СКД должны быть нормализованы в соответствие.");
	КонецЕсли;
	Если ТипЗнч(ИменаПараметровСхемы) <> Тип("Массив") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_schema_graph",
			"Список параметров схемы СКД должен быть массивом.");
	КонецЕсли;

	Переданные = Новый Соответствие;
	ЗначенияПоРегистру = Новый Соответствие;
	Для Каждого КЗ Из Параметры Цикл
		Имя = Строка(КЗ.Ключ);
		ИмяВРегистре = ВРег(Имя);
		Если Переданные.Получить(ИмяВРегистре) <> Неопределено Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("duplicate_parameter",
				"Параметр задан повторно: " + Имя);
		КонецЕсли;
		Переданные.Вставить(ИмяВРегистре, Истина);
		ЗначенияПоРегистру.Вставить(ИмяВРегистре, КЗ.Значение);
		Если Не СодержитИмяПоРегистру(ИменаПараметровСхемы, ИмяВРегистре) Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unknown_parameter",
				"Параметр отсутствует в схеме СКД: " + Имя);
		КонецЕсли;
		Если КЗ.Значение = Неопределено Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_parameter_value",
				"Параметр СКД не может иметь неопределённое значение: " + Имя);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ИмяПараметра Из ИменаПараметровСхемы Цикл
		Имя = Строка(ИмяПараметра);
		Если Переданные.Получить(ВРег(Имя)) = Неопределено Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("missing_parameter",
				"Не передан обязательный параметр схемы СКД: " + Имя);
		КонецЕсли;
		Попытка
			Компоновщик.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(
				Новый ПараметрКомпоновкиДанных(Имя),
				ЗначенияПоРегистру.Получить(ВРег(Имя)));
		Исключение
			Описание = AIR_ReadCore.ТекстОписанияОшибки(ИнформацияОбОшибке());
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_parameter_value",
				"Не удалось применить параметр СКД " + Имя + ": "
				+ AIR_ReadCore.КраткоОбрезать(Описание, 300));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Функция СодержитИмяПоРегистру(Массив, ИмяВРегистре)

	Для Каждого Элемент Из Массив Цикл
		Если ВРег(Строка(Элемент)) = ИмяВРегистре Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ПостроитьМакетДляКоллекции(Схема, Настройки) Экспорт

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Возврат КомпоновщикМакета.Выполнить(Схема, Настройки, , ,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

КонецФункции

Функция ПостроитьМакетДляТабличногоДокумента(Схема, Настройки) Экспорт

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Возврат КомпоновщикМакета.Выполнить(Схема, Настройки);

КонецФункции

Функция ПеречислитьИПроверитьЗапросыМакета(Макет) Экспорт

	Части = Новый Массив;
	Источники = Новый Массив;
	Сведения = Новый Структура;
	Сведения.Вставить("queryParts", Части);
	Сведения.Вставить("sources", Источники);
	Сведения.Вставить("datasetCount", 0);
	Сведения.Вставить("linkCount", 0);

	Если ТипЗнч(Макет) <> Тип("МакетКомпоновкиДанных") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_layout",
			"Компоновщик макета вернул неподдерживаемый объект.");
	КонецЕсли;

	ИсточникиМакета = Макет.ИсточникиДанных;
	Для Индекс = 0 По ИсточникиМакета.Количество() - 1 Цикл
		Источник = ИсточникиМакета.Получить(Индекс);
		Имя = СокрЛП(Строка(Источник.Имя));
		// У скомпонованного ИсточникДанныхМакетаКомпоновкиДанных на 8.3.27
		// свойство называется .Тип; .ТипИсточникаДанных доступно только у
		// schema-источника и сохраняется в ПроверитьСхемуИНастройки.
		ТипИсточника = СокрЛП(Строка(Источник.Тип));
		СтрокаСоединения = СокрЛП(Строка(Источник.СтрокаСоединения));
		Если ТипИсточника <> "Local" ИЛИ СтрокаСоединения <> "" Тогда
			ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_data_source",
				"Макет содержит внешний источник данных: " + Имя);
		КонецЕсли;
		Источники.Добавить(Новый Структура("name,type,connectionString", Имя, ТипИсточника, СтрокаСоединения));
	КонецЦикла;

	Наборы = Макет.НаборыДанных;
	Сведения.datasetCount = Наборы.Количество();
	Если Наборы.Количество() <> 1 Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_multiple_datasets",
			"Скомпонованный макет должен содержать ровно один набор данных.");
	КонецЕсли;
	Набор = Наборы.Получить(0);
	Если ТипЗнч(Набор) <> Тип("НаборДанныхЗапросМакетаКомпоновкиДанных") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_dataset_type",
			"Скомпонованный макет содержит неподдерживаемый набор данных: " + Строка(ТипЗнч(Набор)));
	КонецЕсли;
	ПроверитьВложенныеНаборы(Набор, "НаборыДанных[1]", Части);
	ТекстЗапроса = СокрЛП(Строка(Набор.Запрос));
	Если ТекстЗапроса = "" Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("generated_query_empty",
			"Скомпонованный query dataset содержит пустой текст запроса.");
	КонецЕсли;
	Попытка
		Допуск = AIR_ReadCore.ПроверитьИПодготовитьЗапрос(ТекстЗапроса);
	Исключение
		Описание = AIR_ReadCore.ТекстОписанияОшибки(ИнформацияОбОшибке());
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("generated_query_admission_failed",
			"Скомпонованный запрос не прошёл полный read-only допуск: "
			+ AIR_ReadCore.КраткоОбрезать(Описание, 400));
	КонецПопытки;
	ТекстОтбора = "";
	Если Набор.Отбор <> Неопределено Тогда
		ТекстОтбора = СокрЛП(Строка(Набор.Отбор));
	КонецЕсли;
	Если ТекстОтбора <> "" Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_generated_filter",
			"Скомпонованный dataset содержит Отбор; его выражение не входит в квалифицированный subset.");
	КонецЕсли;
	Сведения.linkCount = Макет.СвязиНаборовДанных.Количество();
	Если Сведения.linkCount <> 0 Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_dataset_links",
			"Скомпонованный макет содержит связи наборов данных.");
	КонецЕсли;

	// Полный admission завершён: исполняется только назначенный canonical text.
	// Setter и readback обязательны до Initialize; сбой — fail-closed отказ.
	Попытка
		Набор.Запрос = Допуск.КаноническийТекст;
	Исключение
		Описание = AIR_ReadCore.ТекстОписанияОшибки(ИнформацияОбОшибке());
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("canonical_text_error",
			"Не удалось назначить допущенный canonical text скомпонованному набору: "
			+ AIR_ReadCore.КраткоОбрезать(Описание, 300));
	КонецПопытки;
	Попытка
		ФактическийТекст = Строка(Набор.Запрос);
	Исключение
		ФактическийТекст = "";
	КонецПопытки;
	Если ФактическийТекст <> Допуск.КаноническийТекст Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("canonical_roundtrip_mismatch",
			"Readback скомпонованного набора не совпал с допущенным canonical text.");
	КонецЕсли;
	Части.Добавить(Новый Структура(
		"path,queryText,queryTextSha256,queryLength,canonicalTextLength,operators,packetElements,allowedSelectVerified,lockRejected,datasetFilterLength",
		"НаборыДанных[1].Запрос", Допуск.КаноническийТекст, Допуск.КаноническийХешSHA256,
		СтрДлина(Допуск.КаноническийТекст), СтрДлина(Допуск.КаноническийТекст), Допуск.ВсегоОператоров,
		Допуск.ЭлементовПакета, Истина, Ложь, СтрДлина(ТекстОтбора)));
	Если Набор.ЗначенияПараметров <> Неопределено Тогда
		Сведения.Вставить("datasetParameterValues", Набор.ЗначенияПараметров.Количество());
	КонецЕсли;

	Сведения.Вставить("queryCount", Части.Количество());
	Возврат Сведения;

КонецФункции

Процедура ПроверитьВложенныеНаборы(Набор, Путь, Части)

	Если Набор.ВложенныеНаборыДанных.Количество() <> 0 Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_nested_datasets",
			"Скомпонованный макет содержит вложенные наборы данных: " + Путь);
	КонецЕсли;

КонецПроцедуры

Функция СоздатьПроцессор(Макет) Экспорт

	Процессор = Новый ПроцессорКомпоновкиДанных;
	// 4-й аргумент: внешние функции запрещены; 5-й: ссылочные поля
	// ограничиваются правом Просмотр. 6-й (менеджер временных таблиц) не
	// передаётся: начальный subset не создаёт временных таблиц.
	Процессор.Инициализировать(Макет, , , Ложь, Истина);
	Возврат Процессор;

КонецФункции

Функция ПодготовитьПроцессорПоМакету(Макет) Экспорт

	// Полный admission и canonical setter/readback выполняются до Initialize;
	// между этими шагами нет новых settings или compile transforms.
	Сведения = ПеречислитьИПроверитьЗапросыМакета(Макет);
	Процессор = СоздатьПроцессор(Макет);
	Возврат Новый Структура("processor,admission", Процессор, Сведения);

КонецФункции

Функция ВыполнитьВКоллекцию(Процессор) Экспорт

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ТаблицаЗначений);
	Возврат ПроцессорВывода.Вывести(Процессор);

КонецФункции

Функция ВыполнитьВТабличныйДокумент(Процессор) Экспорт

	Документ = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(Документ);
	ПроцессорВывода.Вывести(Процессор, Истина);
	Возврат Документ;

КонецФункции

Функция ОчиститьТекстXML(ТекстXML)

	Если ТипЗнч(ТекстXML) <> Тип("Строка") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_schema_xml",
			"XML-схема СКД должна быть строкой.");
	КонецЕсли;
	Текст = СтрЗаменить(ТекстXML, Символ(65279), "");
	Текст = СокрЛП(Текст);
	Если Текст = "" Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_schema_xml",
			"XML-схема СКД пуста.");
	КонецЕсли;
	Возврат Текст;

КонецФункции

Процедура ПроверитьОтсутствиеDTD(ТекстXML)

	ВерхнийРегистр = ВРег(ТекстXML);
	Если СтрНайти(ВерхнийРегистр, "<!DOCTYPE") > 0
		ИЛИ СтрНайти(ВерхнийРегистр, "<!ENTITY") > 0 Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_schema_dtd",
			"DTD и внешние сущности в XML-схеме СКД запрещены.");
	КонецЕсли;

КонецПроцедуры
