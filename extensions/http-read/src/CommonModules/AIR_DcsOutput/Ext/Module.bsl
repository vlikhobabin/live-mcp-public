////////////////////////////////////////////////////////////////////////////////
// Модуль AIR_DcsOutput расширения AIDataRead.
//
// Назначение: bounded вывод результата СКД:
//   * collection result -> rows/columns для JSON/CSV;
//   * табличный документ -> cells/matrix, previewMarkdown и XLSX artifact.
//
// Ограничения формы ответа конечны; полный результат СКД/materialization может
// быть больше выданной части. emittedRows/emittedColumns описывают фактически
// выданные cells (при maxCells последняя строка может быть частичной). Текст
// tabdoc-cell сохраняется независимо от доступности native .Значение; никакого
// text-to-number conversion нет. Модуль не выполняет запросы и не содержит
// HTTP-обработчиков; серверный, неглобальный, непривилегированный.
////////////////////////////////////////////////////////////////////////////////

Функция СформироватьКоллекцию(Таблица, Лимиты) Экспорт

	Если Таблица = Неопределено Тогда
		Таблица = Новый ТаблицаЗначений;
	КонецЕсли;
	Если ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_result",
			"Результат СКД в коллекцию значений должен быть таблицей значений.");
	КонецЕсли;

	МаксСтрок = Лимиты.maxRows;
	МаксКолонок = Лимиты.maxColumns;
	МаксЯчеек = Лимиты.maxCells;
	ВсегоСтрок = Таблица.Количество();
	ВсегоКолонок = Таблица.Колонки.Количество();
	КолонокДляЧтения = Мин(ВсегоКолонок, МаксКолонок);
	Обрезано = ВсегоКолонок > КолонокДляЧтения;

	Колонки = Новый Массив;
	ИменаКолонок = Новый Массив;
	Для Индекс = 0 По КолонокДляЧтения - 1 Цикл
		Колонка = Таблица.Колонки.Получить(Индекс);
		Имя = Строка(Колонка.Имя);
		ИменаКолонок.Добавить(Имя);
		Типы = Новый Массив;
		Попытка
			ТипыОписания = Колонка.ТипЗначения.Типы();
			Для ИндексТипа = 0 По ТипыОписания.Количество() - 1 Цикл
				Если ИндексТипа >= 8 Тогда
					Прервать;
				КонецЕсли;
				Типы.Добавить(Строка(ТипыОписания.Получить(ИндексТипа)));
			КонецЦикла;
		Исключение
			// Тип колонки не влияет на безопасность строкового вывода.
		КонецПопытки;
		Ширина = 0;
		Попытка
			Ширина = Колонка.Ширина;
		Исключение
			Ширина = 0;
		КонецПопытки;
		Колонки.Добавить(Новый Структура("name,typeNames,width", Имя, Типы, Ширина));
	КонецЦикла;

	Строки = Новый Массив;
	ВыведеноЯчеек = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если Строки.Количество() >= МаксСтрок Тогда
			Обрезано = Истина;
			Прервать;
		КонецЕсли;
		Если ВыведеноЯчеек + КолонокДляЧтения > МаксЯчеек Тогда
			Обрезано = Истина;
			Прервать;
		КонецЕсли;
		СтрокаРезультата = Новый Структура;
		Для Каждого Имя Из ИменаКолонок Цикл
			СтрокаРезультата.Вставить(Имя, СтрокаТаблицы[Имя]);
		КонецЦикла;
		Строки.Добавить(СтрокаРезультата);
		ВыведеноЯчеек = ВыведеноЯчеек + КолонокДляЧтения;
	КонецЦикла;

	Значения = Новый Структура;
	Значения.Вставить("rowCount", Строки.Количество());
	Значения.Вставить("columnCount", КолонокДляЧтения);
	Значения.Вставить("rows", Строки);
	Значения.Вставить("truncated", Обрезано);
	Значения.Вставить("resultType", "dcsCollection");

	Возврат Новый Структура(
		"Колонки,Значения,СтрокВозвращено,Обрезано,ВсегоСтрок,ВсегоКолонок",
		Колонки, Значения, Строки.Количество(), Обрезано, ВсегоСтрок, ВсегоКолонок);

КонецФункции

Функция СформироватьТабличныйДокумент(Документ, Лимиты) Экспорт

	Если Документ = Неопределено ИЛИ ТипЗнч(Документ) <> Тип("ТабличныйДокумент") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_result",
			"Результат СКД для render должен быть табличным документом.");
	КонецЕсли;

	ВсегоСтрок = Документ.ВысотаТаблицы;
	ВсегоКолонок = Документ.ШиринаТаблицы;
	СтрокДляЧтения = Мин(ВсегоСтрок, Лимиты.maxRows);
	КолонокДляЧтения = Мин(ВсегоКолонок, Лимиты.maxColumns);
	МаксЯчеек = Лимиты.maxCells;
	Усечено = ВсегоСтрок > СтрокДляЧтения ИЛИ ВсегоКолонок > КолонокДляЧтения;

	Ячейки = Новый Массив;
	ВыведеноЯчеек = 0;
	ВыведеноСтрок = 0;
	ВыведеноКолонок = 0;
	ЯчеекВПоследнейСтроке = 0;
	Для НомерСтроки = 1 По СтрокДляЧтения Цикл
		Если ВыведеноЯчеек >= МаксЯчеек Тогда
			Усечено = Истина;
			Прервать;
		КонецЕсли;
		ЯчеекВТекущейСтроке = 0;
		Для НомерКолонки = 1 По КолонокДляЧтения Цикл
			Если ВыведеноЯчеек >= МаксЯчеек Тогда
				Усечено = Истина;
				Прервать;
			КонецЕсли;
			Область = Документ.Область(НомерСтроки, НомерКолонки);
			Ячейки.Добавить(НоваяЯчейка(НомерСтроки, НомерКолонки, Область));
			ВыведеноЯчеек = ВыведеноЯчеек + 1;
			ЯчеекВТекущейСтроке = ЯчеекВТекущейСтроке + 1;
			ВыведеноКолонок = Макс(ВыведеноКолонок, НомерКолонки);
		КонецЦикла;
		Если ЯчеекВТекущейСтроке > 0 Тогда
			ВыведеноСтрок = НомерСтроки;
			ЯчеекВПоследнейСтроке = ЯчеекВТекущейСтроке;
		КонецЕсли;
	КонецЦикла;

	Извлечение = Новый Структура;
	Извлечение.Вставить("rowCount", ВсегоСтрок);
	Извлечение.Вставить("columnCount", ВсегоКолонок);
	// emittedRows/emittedColumns описывают фактически выданные cells, а не
	// планируемый прямоугольник: emittedRows — последняя строка, где есть хотя
	// бы одна ячейка; emittedColumns — максимальный выданный номер колонки. При
	// maxCells последняя строка может быть частичной: partialLastRow=true.
	Извлечение.Вставить("emittedRows", ВыведеноСтрок);
	Извлечение.Вставить("emittedColumns", ВыведеноКолонок);
	Извлечение.Вставить("emittedCells", ВыведеноЯчеек);
	Извлечение.Вставить("partialLastRow", ВыведеноСтрок > 0 И ЯчеекВПоследнейСтроке < КолонокДляЧтения);
	Извлечение.Вставить("truncated", Усечено);
	Извлечение.Вставить("cells", Ячейки);
	Извлечение.Вставить("resultType", "tableDocument");
	Возврат Извлечение;

КонецФункции

Функция СформироватьPreviewMarkdown(Извлечение, Лимиты) Экспорт

	Если Извлечение.rowCount = 0 ИЛИ Извлечение.columnCount = 0 Тогда
		Возврат "_(empty table document)_";
	КонецЕсли;
	МаксимумPreviewСтрок = Мин(Извлечение.emittedRows, Лимиты.maxPreviewRows);
	МаксимумPreviewКолонок = Извлечение.emittedColumns;
	Если МаксимумPreviewСтрок <= 0 ИЛИ МаксимумPreviewКолонок <= 0 Тогда
		Возврат "_(empty preview)_";
	КонецЕсли;

	КартаЯчеек = Новый Соответствие;
	Для Каждого ДанныеЯчейки Из Извлечение.cells Цикл
		КартаЯчеек.Вставить(КлючКоординат(ДанныеЯчейки.row, ДанныеЯчейки.column), ДанныеЯчейки.text);
	КонецЦикла;

	СтрокиMarkdown = Новый Массив;
	Заголовки = Новый Массив;
	Разделитель = Новый Массив;
	Для НомерКолонки = 1 По МаксимумPreviewКолонок Цикл
		Заголовки.Добавить("C" + Формат(НомерКолонки, "ЧГ=0"));
		Разделитель.Добавить("---");
	КонецЦикла;
	СтрокиMarkdown.Добавить("| " + СтрСоединить(Заголовки, " | ") + " |");
	СтрокиMarkdown.Добавить("| " + СтрСоединить(Разделитель, " | ") + " |");
	Для НомерСтроки = 1 По МаксимумPreviewСтрок Цикл
		ЯчейкиСтроки = Новый Массив;
		Для НомерКолонки = 1 По МаксимумPreviewКолонок Цикл
			Текст = КартаЯчеек.Получить(КлючКоординат(НомерСтроки, НомерКолонки));
			Если Текст = Неопределено Тогда
				Текст = "";
			КонецЕсли;
			ЯчейкиСтроки.Добавить(ЭкранироватьMarkdown(Строка(Текст)));
		КонецЦикла;
		СтрокиMarkdown.Добавить("| " + СтрСоединить(ЯчейкиСтроки, " | ") + " |");
	КонецЦикла;
	Если Извлечение.truncated ИЛИ Извлечение.emittedRows > МаксимумPreviewСтрок Тогда
		СтрокиMarkdown.Добавить("");
		СтрокиMarkdown.Добавить("_Preview truncated_");
	КонецЕсли;
	Возврат СтрСоединить(СтрокиMarkdown, Символы.ПС);

КонецФункции

Функция СформироватьАртефакты(Документ, Запрошенные, ИдентификаторОтчета, Лимиты) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("artifacts", Новый Массив);
	Результат.Вставить("diagnostics", Новый Массив);
	Если Запрошенные = Неопределено ИЛИ Запрошенные.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Обработано = Новый Соответствие;
	Для Каждого ИмяАртефакта Из Запрошенные Цикл
		Формат = НРег(СокрЛП(Строка(ИмяАртефакта)));
		Если Обработано.Получить(Формат) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Обработано.Вставить(Формат, Истина);
		Если Формат <> "xlsx" Тогда
			Результат.diagnostics.Добавить(НоваяДиагностика("artifact_format_unsupported", Формат,
				"Формат артефакта не поддерживается.", Неопределено, Неопределено, Неопределено));
			Продолжить;
		КонецЕсли;
		Попытка
			Поток = Новый ПотокВПамяти;
			Документ.Записать(Поток, ТипФайлаТабличногоДокумента.XLSX);
			Двоичные = Поток.ЗакрытьИПолучитьДвоичныеДанные();
		Исключение
			Результат.diagnostics.Добавить(НоваяДиагностика("artifact_export_failed", Формат,
				"Не удалось сформировать XLSX в текущем runtime.",
				AIR_ReadCore.КраткоОбрезать(AIR_ReadCore.ТекстОписанияОшибки(ИнформацияОбОшибке()), 300),
				Неопределено, Неопределено));
			Продолжить;
		КонецПопытки;
		Размер = Двоичные.Размер();
		Если Размер > Лимиты.maxArtifactBytes Тогда
			Результат.diagnostics.Добавить(НоваяДиагностика("artifact_too_large", Формат,
				"Размер сформированного артефакта превышает maxArtifactBytes.",
				Неопределено, Лимиты.maxArtifactBytes, Размер));
			Продолжить;
		КонецЕсли;
		Артефакт = Новый Структура;
		Артефакт.Вставить("format", "xlsx");
		Артефакт.Вставить("fileName", БезопасноеИмяФайла(ИдентификаторОтчета) + ".xlsx");
		Артефакт.Вставить("sizeBytes", Размер);
		Артефакт.Вставить("sha256", SHA256Base64(Двоичные));
		Артефакт.Вставить("sha256Encoding", "base64");
		Артефакт.Вставить("contentBase64", Base64Строка(Двоичные));
		Результат.artifacts.Добавить(Артефакт);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НоваяЯчейка(НомерСтроки, НомерКолонки, Область) Экспорт

	// Текст — самостоятельное представление cell: у табличного документа он
	// может быть непустым при недоступном native .Значение. Текст сохраняется
	// как есть; text-to-number conversion здесь не выполняется и отсутствие
	// .Значение не означает отсутствие output.
	Текст = "";
	Значение = Неопределено;
	Попытка
		Текст = Строка(Область.Текст);
	Исключение
		Текст = "";
	КонецПопытки;
	Попытка
		Значение = Область.Значение;
	Исключение
		Значение = Неопределено;
	КонецПопытки;
	ЗначениеДоступно = (Значение <> Неопределено);
	Возврат Новый Структура("row,column,text,value,type,valueAvailable",
		НомерСтроки, НомерКолонки, Текст, JSONСовместимоеЗначение(Значение), ИмяТипа(Значение),
		ЗначениеДоступно);

КонецФункции

Функция JSONСовместимоеЗначение(Значение)

	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") ИЛИ ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат XMLСтрока(Значение);
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	ИначеЕсли AIR_ReadCore.ЭтоСсылка(Значение) Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

Функция ИмяТипа(Значение)

	Если Значение = Неопределено Тогда
		Возврат "Undefined";
	КонецЕсли;
	Если Значение = Null Тогда
		Возврат "Null";
	КонецЕсли;
	Возврат Строка(ТипЗнч(Значение));

КонецФункции

Функция КлючКоординат(НомерСтроки, НомерКолонки)

	Возврат Формат(НомерСтроки, "ЧГ=0") + ":" + Формат(НомерКолонки, "ЧГ=0");

КонецФункции

Функция ЭкранироватьMarkdown(Текст)

	Результат = СтрЗаменить(Текст, Символы.ПС, "<br>");
	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	Результат = СтрЗаменить(Результат, "|", "\|");
	Возврат Результат;

КонецФункции

Функция НоваяДиагностика(Код, Артефакт, Сообщение, Подробности, ЛимитБайт, ФактическийРазмер) Экспорт

	Диагностика = Новый Структура;
	Диагностика.Вставить("code", Код);
	Диагностика.Вставить("message", Сообщение);
	Если Артефакт <> Неопределено И Артефакт <> "" Тогда
		Диагностика.Вставить("artifact", Артефакт);
	КонецЕсли;
	Если Подробности <> Неопределено И Не ПустаяСтрока(Строка(Подробности)) Тогда
		Диагностика.Вставить("details", Подробности);
	КонецЕсли;
	Если ЛимитБайт <> Неопределено Тогда
		Диагностика.Вставить("limitBytes", ЛимитБайт);
	КонецЕсли;
	Если ФактическийРазмер <> Неопределено Тогда
		Диагностика.Вставить("actualBytes", ФактическийРазмер);
	КонецЕсли;
	Возврат Диагностика;

КонецФункции

Функция SHA256Base64(Двоичные) Экспорт

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Двоичные);
	Возврат Base64Строка(Хеширование.ХешСумма);

КонецФункции

Функция БезопасноеИмяФайла(ИсходноеИмя) Экспорт

	Результат = СокрЛП(Строка(?(ИсходноеИмя = Неопределено, "", ИсходноеИмя)));
	Если Результат = "" Тогда
		Результат = "render";
	КонецЕсли;
	Запрещенные = Новый Массив;
	Запрещенные.Добавить("/");
	Запрещенные.Добавить("\");
	Запрещенные.Добавить(":");
	Запрещенные.Добавить("*");
	Запрещенные.Добавить("?");
	Запрещенные.Добавить("""");
	Запрещенные.Добавить("<");
	Запрещенные.Добавить(">");
	Запрещенные.Добавить("|");
	Запрещенные.Добавить(" ");
	Для Каждого Символ Из Запрещенные Цикл
		Результат = СтрЗаменить(Результат, Символ, "_");
	КонецЦикла;
	Пока СтрНайти(Результат, "__") > 0 Цикл
		Результат = СтрЗаменить(Результат, "__", "_");
	КонецЦикла;
	Если Результат = "" Тогда
		Результат = "render";
	КонецЕсли;
	Возврат Лев(Результат, 80);

КонецФункции
