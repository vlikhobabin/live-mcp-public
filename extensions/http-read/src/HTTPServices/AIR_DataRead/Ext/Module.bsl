// Выполнение и результат

Функция ВыполнитьПроверенныйЗапрос(Проверка, Параметры, Лимиты)

	Менеджер = Новый МенеджерВременныхТаблиц;
	Попытка
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Менеджер;
		Запрос.Текст = Проверка.КаноническийТекст;
		Для Каждого КЗ Из Параметры Цикл
			Запрос.УстановитьПараметр(КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
		РезультатыПакета = Запрос.ВыполнитьПакет();
		РезультатЗапроса = РезультатыПакета.Получить(Проверка.ИндексРезультата);
		Значения = СчитатьРезультат(РезультатЗапроса, Лимиты);
	Исключение
		Информация = ИнформацияОбОшибке();
		// Cleanup обязателен и при ошибке; его сбой не заменяет primary error.
		Попытка
			Менеджер.Закрыть();
		Исключение
			ИнформацияЗакрытия = ИнформацияОбОшибке();
		КонецПопытки;
		Описание = AIR_ReadCore.ТекстОписанияОшибки(Информация);
		// ОтветИзИсключения уже разбирает AIR|code|message: сохраняем исходную
		// service-ошибку без повторной обёртки. Настоящие платформенные
		// исключения по-прежнему получают query_execution_error.
		Префикс = "AIR|";
		Если СтрДлина(Описание) >= СтрДлина(Префикс) И Лев(Описание, СтрДлина(Префикс)) = Префикс Тогда
			ВызватьИсключение Описание;
		КонецЕсли;
		Описание = AIR_ReadCore.КраткоОбрезать(Описание, 500);
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("query_execution_error",
			"Запрос завершился ошибкой выполнения: " + Описание);
	КонецПопытки;
	Попытка
		Менеджер.Закрыть();
	Исключение
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("temp_manager_close_error",
			"Не удалось закрыть менеджер временных таблиц.");
	КонецПопытки;

	Возврат Новый Структура(
		"Значения,Колонки,СтрокВозвращено,Обрезано",
		Значения.Данные, Значения.Колонки, Значения.СтрокВозвращено, Значения.Обрезано);

КонецФункции

Функция СчитатьРезультат(РезультатЗапроса, Лимиты)

	Если РезультатЗапроса = Неопределено Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("result_unavailable", "Пакет не вернул результат SELECT.");
	КонецЕсли;
	КоллекцияКолонок = РезультатЗапроса.Колонки;
	КоличествоКолонок = КоллекцияКолонок.Количество();
	Если КоличествоКолонок > Лимиты.maxColumns Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("columns_limit_exceeded",
			"Число колонок результата превышает допустимое.");
	КонецЕсли;

	Колонки = Новый Массив;
	ИменаКолонок = Новый Массив;
	Для Индекс = 0 По КоличествоКолонок - 1 Цикл
		Колонка = КоллекцияКолонок.Получить(Индекс);
		Имя = Колонка.Имя;
		ИменаКолонок.Добавить(Имя);
		Типы = Новый Массив;
		ОписаниеТипа = Колонка.ТипЗначения;
		ТипыОписания = ОписаниеТипа.Типы();
		Для ИндексТипа = 0 По ТипыОписания.Количество() - 1 Цикл
			Если ИндексТипа >= 8 Тогда
				Прервать;
			КонецЕсли;
			Типы.Добавить(Строка(ТипыОписания.Получить(ИндексТипа)));
		КонецЦикла;
		Колонки.Добавить(Новый Структура("name,typeNames,width", Имя, Типы, Колонка.Ширина));
	КонецЦикла;

	МаксСтрок = Лимиты.maxRows;
	Если КоличествоКолонок > 0 Тогда
		МаксСтрокПоЯчейкам = Цел(Лимиты.maxCells / КоличествоКолонок);
		// maxCells меньше числа колонок: одна строка уже нарушила бы cap,
		// поэтому допустимое число строк — 0, а наличие строк даст truncated.
		Если МаксСтрокПоЯчейкам < МаксСтрок Тогда
			МаксСтрок = МаксСтрокПоЯчейкам;
		КонецЕсли;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("rowCount", 0);
	Данные.Вставить("columnCount", КоличествоКолонок);
	Данные.Вставить("truncated", Ложь);
	Данные.Вставить("columns", Колонки);
	Данные.Вставить("rows", Новый Массив);
	Данные.Вставить("resultType", "queryResult");

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Данные.rows.Количество() >= МаксСтрок Тогда
			Данные.Вставить("truncated", Истина);
			Прервать;
		КонецЕсли;
		СтрокаРезультата = Новый Структура;
		Для Индекс = 0 По КоличествоКолонок - 1 Цикл
			СтрокаРезультата.Вставить(ИменаКолонок.Получить(Индекс), Выборка[Индекс]);
		КонецЦикла;
		Данные.rows.Добавить(СтрокаРезультата);
	КонецЦикла;
	КоличествоСтрок = Данные.rows.Количество();
	Данные.Вставить("rowCount", КоличествоСтрок);

	Возврат Новый Структура(
		"Данные,Колонки,СтрокВозвращено,Обрезано",
		Данные, Колонки, КоличествоСтрок, Данные.truncated);

КонецФункции

Функция СформироватьCSV(Результат)

	ИменаКолонок = Новый Массив;
	Для Каждого Колонка Из Результат.Колонки Цикл
		ИменаКолонок.Добавить(Колонка.name);
	КонецЦикла;
	Части = Новый Массив;
	Заголовок = Новый Массив;
	Для Каждого Имя Из ИменаКолонок Цикл
		Заголовок.Добавить(ЭкранироватьCSV(Имя));
	КонецЦикла;
	Части.Добавить(СтрСоединить(Заголовок, ";"));
	Для Каждого СтрокаРезультата Из Результат.Значения.rows Цикл
		Значения = Новый Массив;
		Для Каждого Имя Из ИменаКолонок Цикл
			ЗначениеПоля = Неопределено;
			Если СтрокаРезультата.Свойство(Имя, ЗначениеПоля) Тогда
				Значения.Добавить(ЭкранироватьCSV(ПредставлениеCSV(ЗначениеПоля)));
			Иначе
				Значения.Добавить("");
			КонецЕсли;
		КонецЦикла;
		Части.Добавить(СтрСоединить(Значения, ";"));
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС) + Символы.ПС;

КонецФункции

Функция ПредставлениеCSV(Значение)

	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Булево") ИЛИ ТипЗначения = Тип("Дата")
		ИЛИ ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат XMLСтрока(Значение);
	ИначеЕсли AIR_ReadCore.ЭтоСсылка(Значение) Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("unsupported_result_value",
		"Тип значения результата не поддерживается в CSV: " + Строка(ТипЗначения));

КонецФункции

Функция ЭкранироватьCSV(Значение)

	Текст = Строка(Значение);
	Если СтрНайти(Текст, ";") > 0
		ИЛИ СтрНайти(Текст, """") > 0
		ИЛИ СтрНайти(Текст, Символы.ПС) > 0
		ИЛИ СтрНайти(Текст, Символы.ВК) > 0 Тогда
		Возврат """" + СтрЗаменить(Текст, """", """""") + """";
	КонецЕсли;
	Возврат Текст;

КонецФункции
