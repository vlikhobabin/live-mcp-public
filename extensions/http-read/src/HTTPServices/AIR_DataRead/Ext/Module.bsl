	Если ТипЗнч(Параметры) <> Тип("Массив") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("invalid_request", "Поле parameters должно быть массивом.");
	КонецЕсли;
	Если Параметры.Количество() > AIR_ReadCore.ТвердыйМаксимум("maxParameters") Тогда
		ВызватьИсключение AIR_ReadCore.ОшибкаСервиса("too_many_parameters", "Количество параметров превышает допустимое.");
	КонецЕсли;
	Возврат Параметры;

